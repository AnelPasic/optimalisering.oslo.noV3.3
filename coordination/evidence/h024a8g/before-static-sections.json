{
  "regneeksempel": "<section id=\"regneeksempel\" class=\"leverage-section section-space\" data-leverage=\"\" data-undefined-increase=\"Forholdstall kan ikke beregnes for dette utgangspunktet\" data-astro-cid-eprr3drd=\"\"><div class=\"shell calculator-introduction\" data-astro-cid-eprr3drd=\"\"><p class=\"eyebrow\" data-astro-cid-eprr3drd=\"\">Synlighet og konvertering forsterker hverandre</p><h2 data-astro-cid-eprr3drd=\"\">Hva betyr flere relevante besøk og en bedre kjøpsvei?</h2><p class=\"body-copy\" data-astro-cid-eprr3drd=\"\">Endre trafikken, andelen som tar kontakt eller kjøper - eller begge. Se hvordan de to grepene virker sammen.</p><p class=\"calculator-formula\" data-astro-cid-eprr3drd=\"\"><a class=\"term-trigger\" data-term=\"relevant-trafikk\" href=\"/begreper/#relevant-trafikk\">Relevante besøk</a> x <a class=\"term-trigger\" data-term=\"konverteringsrate\" href=\"/begreper/#konverteringsrate\">konverteringsrate</a> = henvendelser / kjøp</p></div><div class=\"shell leverage-grid\" data-astro-cid-eprr3drd=\"\"><div class=\"leverage-copy\" data-astro-cid-eprr3drd=\"\"><div class=\"calculator-inputs\" data-astro-cid-eprr3drd=\"\"><div class=\"calculator-field\" data-astro-cid-eprr3drd=\"\"><label for=\"calc-visits\" data-astro-cid-eprr3drd=\"\">Relevante besøk per måned<input class=\"input w-full\" id=\"calc-visits\" name=\"visits\" type=\"number\" min=\"0\" max=\"10000000\" step=\"250\" value=\"2000\" inputmode=\"numeric\" aria-describedby=\"calculator-error\" data-astro-cid-eprr3drd=\"\"></label></div><div class=\"calculator-field\" data-astro-cid-eprr3drd=\"\"><label id=\"calc-conversion-label\" for=\"calc-conversion\" data-astro-cid-eprr3drd=\"\">Konverteringsrate i dag (%)<input class=\"input w-full\" id=\"calc-conversion\" name=\"conversion\" type=\"number\" min=\"0\" max=\"100\" step=\"0.5\" value=\"0.5\" inputmode=\"decimal\" aria-describedby=\"calculator-error\" data-astro-cid-eprr3drd=\"\"></label><input class=\"range range-accent\" type=\"range\" min=\"0\" max=\"100\" step=\"0.5\" value=\"0.5\" data-slider=\"conversion\" aria-labelledby=\"calc-conversion-label\" disabled=\"\" data-astro-cid-eprr3drd=\"\"></div><div class=\"calculator-field\" data-astro-cid-eprr3drd=\"\"><label for=\"calc-traffic\" data-astro-cid-eprr3drd=\"\">Mer relevant trafikk per måned (%)<input class=\"input w-full\" id=\"calc-traffic\" name=\"trafficIncrease\" type=\"number\" min=\"0\" max=\"1000\" step=\"any\" value=\"10\" inputmode=\"decimal\" aria-describedby=\"calculator-error\" data-astro-cid-eprr3drd=\"\"></label></div><div class=\"calculator-field\" data-astro-cid-eprr3drd=\"\"><label id=\"calc-new-conversion-label\" for=\"calc-new-conversion\" data-astro-cid-eprr3drd=\"\">Ny konverteringsrate (%)<input class=\"input w-full\" id=\"calc-new-conversion\" name=\"newConversion\" type=\"number\" min=\"0\" max=\"100\" step=\"0.5\" value=\"2\" inputmode=\"decimal\" aria-describedby=\"calculator-error\" data-astro-cid-eprr3drd=\"\"></label><input class=\"range range-accent\" type=\"range\" min=\"0\" max=\"100\" step=\"0.5\" value=\"2\" data-slider=\"newConversion\" aria-labelledby=\"calc-new-conversion-label\" disabled=\"\" data-astro-cid-eprr3drd=\"\"></div></div><p id=\"calculator-error\" class=\"calculator-error\" role=\"status\" hidden=\"\" data-astro-cid-eprr3drd=\"\">Bruk besøk fra 0 til 10 000 000, trafikkøkning fra 0 til 1 000 % og konverteringsrater fra 0 til 100 %.</p><div class=\"calculator-results\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" data-astro-cid-eprr3drd=\"\"><div class=\"math-results\" data-astro-cid-eprr3drd=\"\"><div class=\"leverage-result\" data-astro-cid-eprr3drd=\"\"><span data-astro-cid-eprr3drd=\"\">I dag</span><output data-current=\"\" data-astro-cid-eprr3drd=\"\">10</output><span class=\"outcome-label\" data-astro-cid-eprr3drd=\"\">henvendelser / kjøp per måned</span><span class=\"math-equation\" data-current-equation=\"\" data-astro-cid-eprr3drd=\"\">2&nbsp;000 × 0,5 %</span></div>