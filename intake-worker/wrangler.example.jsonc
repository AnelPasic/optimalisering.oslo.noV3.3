{
  // Copy to wrangler.jsonc locally after creating the database; do not commit real IDs/secrets.
  "name": "medon-form-intake",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "medon-intake",
    "database_id": "REPLACE-WITH-D1-ID",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/10 * * * *"] }
}
