---
import type { CollectionEntry } from 'astro:content';
import CommercialHero from './CommercialHero.astro';
import {resolvePageHero} from '../lib/page-hero';
import ClosingCta from './ClosingCta.astro';
import ContentSection from './ContentSection.astro';
import AssessmentForm from './AssessmentForm.astro';
import Faq from './Faq.astro';
interface Props { page: CollectionEntry<'pages'>['data']; }
const { page } = Astro.props;
const isAssessment = page.kind === 'assessment';
const isArticle = page.kind === 'article';
---
<CommercialHero content={resolvePageHero(page)}>{isAssessment&&<AssessmentForm slot="auxiliary"/>}</CommercialHero>
<div class:list={{ 'article-content': isArticle }}>{page.sections.map((section, index) => <ContentSection section={section} index={index} />)}</div>
<Faq items={page.faq} />
{!isAssessment && page.kind !== 'utility' && <ClosingCta link={page.cta} />}
