---
import type { CollectionEntry } from 'astro:content';
import CommercialHero from './CommercialHero.astro';
import {resolvePageHero} from '../lib/page-hero';
import ClosingCta from './ClosingCta.astro';
import ContentSection from './ContentSection.astro';
import AssessmentForm from './AssessmentForm.astro';
import Faq from './Faq.astro';
import GlobalContentSection from './GlobalContentSection.astro';
import PageList from './PageList.astro';
import { visibleServiceSections } from '../lib/service-sections';
interface Props { page: CollectionEntry<'pages'>['data']; }
const { page } = Astro.props;
const isAssessment = page.kind === 'assessment';
const isArticle = page.kind === 'article';
const hasGlobalFaq = page.sections.some(section => section.globalElement === 'sporsmal');
const hasGlobalAssessment = page.sections.some(section => section.globalElement === 'sjekk');
---
<CommercialHero content={resolvePageHero(page)}>{isAssessment&&!hasGlobalAssessment&&<AssessmentForm slot="auxiliary"/>}</CommercialHero>
<div class:list={{ 'article-content': isArticle }}>{visibleServiceSections(page).map((section, index) => section.globalElement
  ? <GlobalContentSection element={section.globalElement} faqItems={page.faq} />
  : section._block === 'pageList' ? <PageList section={section} />
  : <ContentSection section={section} index={index} />)}</div>
{!hasGlobalFaq && <Faq items={page.faq} />}
{!isAssessment && page.kind !== 'utility' && <ClosingCta link={page.cta} />}
