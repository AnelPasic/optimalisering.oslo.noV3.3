---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props {
  content: NonNullable<CollectionEntry<'pages'>['data']['homepage']>['packages'];
  showHeading?: boolean;
  showNotes?: boolean;
  headingTag?: 'h2' | 'h3';
  labelledBy?: string;
  recommendedAnchor?: string;
}
const { content, showHeading = true, showNotes = true, headingTag: Heading = 'h3', labelledBy, recommendedAnchor } = Astro.props;
const formatPrice = (value: number) => new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 0 }).format(value);
---
<section id="priser" class="package-section section-space" aria-labelledby={labelledBy}>
  <div class="shell">
    {showHeading && <div class="section-heading"><p class="eyebrow">{content.eyebrow}</p><h2>{content.heading}</h2><p class="body-copy">{content.intro}</p></div>}
    <div class="package-grid">{content.items.map((item, index) => <article id={index === 1 ? recommendedAnchor : undefined} class={`package-card package-card-${index}${item.recommended ? ' is-recommended' : ''}`}>
      <div class="package-heading"><Heading>{item.title}</Heading>{item.recommended && item.badge && <span class="package-badge">{item.badge}</span>}</div>
      <p class="package-descriptor">{item.descriptor}</p>
      <dl><dt>{content.fitLabel}</dt><dd>{item.fit}</dd><dt>{content.scopeLabel}</dt><dd>{item.scope}</dd></dl>
      <div class="package-price"><p><span class="package-price-amount">{formatPrice(item.price)}</span> <span class="package-price-unit">{item.priceSuffix}</span></p><p class="small-copy">{item.vatSuffix}</p></div>
      <a class="button" href={item.cta.href}>{item.cta.label}<Arrow diagonal /></a>
    </article>)}</div>
    {showNotes && <div class="package-notes body-copy"><p>{content.areasLabel}: {content.areas.join(' · ')}.</p><p>{content.foundationNote}</p><p class="package-budget-note">{content.adBudgetNote}</p><p>{content.externalCostsNote}</p><p>{content.separateWorkNote}</p><p>{content.capacityNote}</p></div>}
  </div>
</section>
