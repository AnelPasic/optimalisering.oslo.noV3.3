---
import PhosphorIcon from './PhosphorIcon.astro';
import CardBadge from './CardBadge.astro';
import type { HomepageContent } from '../lib/home-section-data';
import '../styles/compositions/package.css';
import Arrow from './Arrow.astro';
import Visual from './PackageVisual.astro';
import FocusIcon from './PackageFocusIcon.astro';
import TermText from './TermText.astro';
import PackageOrder from './PackageOrder.astro';
import { groupPackageServices } from '../lib/package-service-groups';
interface Props {
  content: HomepageContent['packages'];
  showHeading?: boolean;
  showNotes?: boolean;
  headingTag?: 'h2' | 'h3';
  labelledBy?: string;
  recommendedAnchor?: string;
  mode?: 'compact' | 'expanded';
}
const { content, showHeading = true, showNotes = true, headingTag: Heading = 'h3', labelledBy, recommendedAnchor, mode = 'compact' } = Astro.props;
const expanded = mode === 'expanded';
const formatPrice = (value: number) => new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 0 }).format(value);
---
<section id="priser" class:list={['package-section', 'package-offer', 'section-space', { 'package-offer-full': expanded }]} aria-labelledby={labelledBy}>
  <div class="shell">
    {showHeading && <div class="section-heading"><p class="eyebrow">{content.eyebrow}</p><h2>{content.heading}</h2><p class="body-copy">{content.intro}</p></div>}
    <span id="bestill" class="sr-only" aria-hidden="true"></span>
    <div class="package-grid">{content.items.map((item, index) => <article id={expanded ? item.detailLink.href.split('#')[1] : undefined} class:list={['package-card',`package-card-${index}`,'card card-border min-w-0',item.recommended?'is-recommended bg-base-300 border-2 border-secondary':'bg-base-100 border-base-300']}>
      {expanded && index === 1 && recommendedAnchor && item.detailLink.href.split('#')[1] !== recommendedAnchor && <span id={recommendedAnchor} aria-hidden="true"></span>}
      <div class="card-body min-w-0 gap-0">
      <div class="package-top"><div class="package-heading"><Heading>{item.title}</Heading><CardBadge text={item.badge} badgeClass={item.badgeClass ?? (item.recommended ? 'badge-success' : 'badge')} class="package-badge" /><PhosphorIcon name={item.iconName} class="size-6 shrink-0" /></div>
      <div class="package-price"><p>{item.pricePrefix && <span class="package-price-prefix">{item.pricePrefix} </span>}<span class="package-price-amount">{formatPrice(item.price)}</span> <span class="package-price-unit">{item.priceSuffix}</span></p><p class="small-copy">{item.vatSuffix}</p></div></div>
      <p class="package-descriptor">{item.descriptor}</p>
      <Visual kind={item.visual} motifId={`package-${expanded ? 'pricing' : 'home'}-${item.key}`} svg={item.visualSvg} asset={item.visualAsset} caption={item.visualCaption} />
      <div class="package-focus">
        <h3 class="package-block-heading package-services-heading">Tjenester inkludert</h3>
        <p class="package-services-note">{item.key === 'optimalisering' ? 'Én av tjenestene prioriteres om gangen.' : item.key === 'vekst' ? 'To av tjenestene prioriteres samtidig.' : 'Tjenester og kapasitet prioriteres etter avtale.'}</p>
        {groupPackageServices(item.iconItems).filter(group => group.label !== 'Systemer').map(group => <section class="package-service-group" data-service-category={group.label}>
          <h4 class="package-service-group-heading">{group.label}</h4>
          <ul class="package-icon-items">{group.items.map(focus => <li><FocusIcon kind={focus.icon} iconName={focus.iconName} /><span><TermText text={focus.compactLabel} terms={['seo', 'lokal-seo', 'ai-synlighet', 'google-ads', 'meta-ads', 'cro']} /></span></li>)}</ul>
        </section>)}
      </div>
      <PackageOrder item={item} featured={item.recommended} orderIntro={content.orderIntro} orderSubmitLabel={content.orderSubmitLabel} />
      <details class="package-details"><summary>{item.detailLink.label}</summary><div class="package-detail">
        <div class="package-situations">
          <h3 class="package-block-heading">{content.labels.situations}</h3>
          <ul>{item.compact.situations.map(text => <li>{text}</li>)}</ul>
        </div>
        <div class="package-fit-goals">
          <h3 class="package-block-heading">{content.fitLabel}</h3>
          <p class="package-fit">{item.compact.fit}</p>
          {item.scope && <div class="package-scope"><h3 class="package-block-heading">{content.scopeLabel}</h3><p>{item.scope}</p></div>}
        </div>
        {groupPackageServices(item.iconItems).filter(group => group.label === 'Systemer').map(group => <section class="package-service-group package-included-systems" data-service-category={group.label}>
          <h4 class="package-service-group-heading">Systemer inkludert</h4>
          <ul class="package-icon-items">{group.items.map(focus => <li><FocusIcon kind={focus.icon} iconName={focus.iconName} /><span><TermText text={focus.compactLabel} terms={['seo', 'lokal-seo', 'ai-synlighet', 'google-ads', 'meta-ads', 'cro']} /></span></li>)}</ul>
        </section>)}
        {item.distinction && <p>{item.distinction}</p>}
        {item.priceNote && <p class="package-price-note">{item.priceNote}</p>}
      </div></details>
      </div>
    </article>)}</div>
    {showNotes && <div class="package-notes body-copy"><p class="package-budget-note">{content.adBudgetNote}</p><a class="text-link package-uncertain" href="/#sjekk">{content.labels.uncertain}<Arrow /></a></div>}
  </div>
</section>
