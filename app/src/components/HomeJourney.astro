---
import Arrow from './Arrow.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { content: NonNullable<CollectionEntry<'pages'>['data']['homepage']>['illustration']; }
const { content } = Astro.props;
---
<div class="outcome-art" role="img" aria-label={content.ariaLabel}>
  <div class="outcome-search" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
    <span>{content.search}</span>
  </div>
  <div class="outcome-page" aria-hidden="true">
    <div class="outcome-business"><span class="small-dot"></span>{content.business}</div>
    <span class="outcome-heading">{content.heading}</span>
    <span class="outcome-description">{content.description}</span>
    <div class="outcome-next">
      <span class="outcome-action">{content.action}<Arrow diagonal /></span>
      <div class="outcome-receipt">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" /><path d="m7.5 12 3 3 6-6" /></svg>
        <span>{content.outcome}</span>
      </div>
    </div>
  </div>
  <span class="outcome-caption" aria-hidden="true">{content.label}</span>
</div>
