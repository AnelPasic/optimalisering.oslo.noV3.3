---
import HomeSymbol from './HomeSymbol.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { content: NonNullable<CollectionEntry<'pages'>['data']['homepage']>['illustration']; }
const { content } = Astro.props;
---
<div class="journey-art" role="img" aria-label={content.ariaLabel}>
  <div class="journey-top"><span>{content.label}</span><span aria-hidden="true">↗</span></div>
  <div class="journey-steps">{content.steps.map((step, index) => <div class={`journey-card journey-step-${index}`}>
    <div class="journey-card-top"><span class="journey-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><HomeSymbol kind={index === 0 ? 'search' : 'choose'} /></div>
    <span class="journey-label">{step.title}</span><span class="journey-caption">{step.caption}</span>
  </div>)}</div>
  <div class="journey-bottom"><span class="small-dot"></span><span>{content.footer}</span></div>
</div>
