---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; }
const { section } = Astro.props;
---
<section id={section.id} class="leverage-section section-space">
  <div class="shell leverage-grid">
    <div><p class="eyebrow">{section.eyebrow}</p><h2>{section.heading}</h2><div class="body-copy">{section.body.map(text => <p>{text.split(/(\d{1,3}(?: \d{3})+)/).map((part, index) => index % 2 === 1 ? <span style="white-space: nowrap">{part}</span> : part)}</p>)}</div>{section.links?.map(link => <a class="text-link" href={link.href}>{link.label}<Arrow /></a>)}</div>
    <div class="leverage-tool" data-leverage>
      <div class="leverage-label">Illustrerende regneeksempel</div>
      <div class="leverage-inputs"><label>Relevante besøk<input name="visits" type="number" min="0" max="10000000" step="100" value="1000" inputmode="numeric" /></label><span aria-hidden="true">×</span><label>Tar kontakt<input name="conversion" type="number" min="0" max="100" step="0.5" value="1" inputmode="decimal" /><span class="input-unit">%</span></label></div>
      <div class="leverage-result"><span>=</span><output aria-live="polite">10</output><span>henvendelser</span></div>
      <div class="leverage-comparison"><span>Hvis andelen dobles</span><strong><output data-double>20</output> henvendelser</strong></div>
      <p class="small-copy">Samme antall besøk. Endret andel. Et regnestykke, ingen resultatgaranti.</p>
    </div>
  </div>
</section>
<script>
  import { calculateLeverage } from '../lib/leverage';
  const tool = document.querySelector<HTMLElement>('[data-leverage]');
  if (tool) {
    const visits = tool.querySelector<HTMLInputElement>('[name="visits"]')!;
    const conversion = tool.querySelector<HTMLInputElement>('[name="conversion"]')!;
    const output = tool.querySelector<HTMLOutputElement>('output')!;
    const doubled = tool.querySelector<HTMLOutputElement>('[data-double]')!;
    const formatter = new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 1 });
    const update = () => {
      if (visits.value === '' || conversion.value === '' || !visits.checkValidity() || !conversion.checkValidity()) { output.value = '–'; doubled.value = '–'; return; }
      output.value = formatter.format(calculateLeverage(Number(visits.value), Number(conversion.value)));
      doubled.value = Number(conversion.value) <= 50 ? formatter.format(calculateLeverage(Number(visits.value), Number(conversion.value) * 2)) : '–';
    };
    visits.addEventListener('input', update);
    conversion.addEventListener('input', update);
  }
</script>
