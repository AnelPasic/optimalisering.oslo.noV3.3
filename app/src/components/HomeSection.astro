---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import TermText from './TermText.astro';
import { surfaceAttribute } from '../lib/surface';
import { headingAlignAttribute } from '../lib/heading-alignment';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; index?: number; visualId?: 'behov' | 'kanaler'; }
const { section, visualId } = Astro.props;
const protectedRow = section._block === 'protected' || section.id === 'sjekk';
const terms = Astro.url.pathname === '/synlighet/' ? ['seo', 'lokal-seo', 'ai-synlighet'] : Astro.url.pathname === '/konvertering/' ? ['cro', 'konverteringsrate', 'ordreverdi', 'margin', 'relevant-trafikk'] : [];
---
<section id={section.id} class={`content-section section-space home-section-${visualId ?? section.id}`} data-surface={surfaceAttribute(section.surface, protectedRow)}>
  <div class="shell">
    <div class="section-heading" data-heading-align={headingAlignAttribute(section.headingAlign)}><div>{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}<h2>{section.heading}</h2></div><div class="body-copy">{section.body.map(text => <p><TermText text={text} terms={terms} /></p>)}</div></div>
    {section.items && <div class:list={['section-items', { 'two-items': section.items.length === 2, 'mechanism-steps': section.id === 'mekanisme' }]}>{section.items.map((item, i) => <article class={`info-item home-item-${i}`} data-surface={surfaceAttribute(item.surface, protectedRow)}>
      {section.id === 'mekanisme' && <span class="item-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
      <h3><TermText text={item.title} terms={terms} /></h3><p>{item.text}</p>{item.href && <a class="text-link" href={item.href}>{item.label || item.title}<Arrow diagonal /></a>}
    </article>)}</div>}
    {section.links && <div class="section-links">{section.links.map(link => <a class="text-link" href={link.href}>{link.label}<Arrow /></a>)}</div>}
    <slot />
  </div>
</section>
