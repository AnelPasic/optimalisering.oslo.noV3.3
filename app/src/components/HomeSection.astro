---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import HomeSymbol from './HomeSymbol.astro';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; index?: number; }
const { section } = Astro.props;
---
<section id={section.id} class={`content-section section-space home-section-${section.id}`}>
  <div class="shell">
    <div class="section-heading section-heading-split"><div>{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}<h2>{section.heading}</h2></div><div class="body-copy">{section.body.map(text => <p>{text}</p>)}</div></div>
    {section.items && <div class:list={['section-items', { 'two-items': section.items.length === 2 }]}>{section.items.map((item, i) => <article class={`info-item home-item-${i}`}><div class="home-card-top"><span class="item-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><HomeSymbol kind={i === 0 ? 'search' : i === 1 ? 'choose' : 'both'} /></div><h3>{item.title}</h3><p>{item.text}</p>{item.href && <a class="text-link" href={item.href}>{item.label || item.title}<Arrow diagonal /></a>}</article>)}</div>}
    {section.links && <div class="section-links">{section.links.map(link => <a class="text-link" href={link.href}>{link.label}<Arrow /></a>)}</div>}
  </div>
</section>
