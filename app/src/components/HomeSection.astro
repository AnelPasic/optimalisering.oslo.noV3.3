---
import '../styles/compositions/sections.css';
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import TermText from './TermText.astro';
import ContentCard from './ContentCard.astro';
import RichMarkdown from './RichMarkdown.astro';
import {hasRichMarkdown} from '../lib/rich-markdown';
import { surfaceAttribute } from '../lib/surface';
import { headingAlignAttribute } from '../lib/heading-alignment';
import {contentLayoutAttribute,boxVariantAttribute,paragraphLayoutAttribute} from '../lib/content-presentation';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; index?: number; visualId?: 'behov' | 'kanaler'; linkVariant?:'button'; defaultSurface?:'secondary'; anchor?:string; infoSurface?:boolean; }
const { section, visualId, linkVariant, defaultSurface, anchor, infoSurface = false } = Astro.props;
const protectedRow = section._block === 'protected';
const cards=!!visualId;
const terms = Astro.url.pathname === '/synlighet/' ? ['seo', 'lokal-seo', 'ai-synlighet'] : Astro.url.pathname === '/konvertering/' ? ['cro', 'konverteringsrate', 'ordreverdi', 'margin', 'relevant-trafikk'] : Astro.url.pathname === '/seo/' ? ['seo'] : Astro.url.pathname === '/ai-synlighet/' ? ['ai-synlighet', 'aeo', 'aio', 'geo', 'seo'] : Astro.url.pathname === '/nettbutikkoptimalisering/' ? ['checkout', 'ordreverdi', 'margin', 'konverteringsrate'] : [];
---
<section id={anchor??section.id} class:list={[`content-section section-space home-section-${visualId ?? section.id}`,{'bg-info text-info-content':infoSurface}]} data-surface={infoSurface?'info':surfaceAttribute(section.surface, protectedRow)??(protectedRow?undefined:defaultSurface)}>
  <div class="shell">
    <div class="section-heading" data-heading-align={headingAlignAttribute(section.headingAlign)}><div>{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}<h2>{section.heading}</h2></div><div class="body-copy" data-content-layout={paragraphLayoutAttribute(section,protectedRow)}>{section.body.map(text => hasRichMarkdown(text)?<RichMarkdown text={text}/>:<p><TermText text={text} terms={terms}/></p>)}</div></div>
    {section.items && <div class:list={['section-items', { 'two-items': section.items.length === 2, 'mechanism-steps': section.id === 'mekanisme', 'max-sm:grid-cols-1':section.id==='mekanisme'&&section.items.some(item=>boxVariantAttribute(item.boxVariant,protectedRow)==='card') }]} data-content-layout={contentLayoutAttribute(section.layout,protectedRow)}>{section.items.map((item, i) => (boxVariantAttribute(item.boxVariant,protectedRow)==='card'||(cards&&boxVariantAttribute(item.boxVariant,protectedRow)!=='plain'))?<ContentCard title={item.title} text={item.text} surface={surfaceAttribute(item.surface,protectedRow)??(visualId==='behov'?(['info','base-300','base-200'] as const)[i%3]:visualId==='kanaler'?(['base-300','info','base-100'] as const)[i%3]:undefined)} number={section.id==='mekanisme'?String(i+1).padStart(2,'0'):undefined} href={item.href} label={item.label} titleTerms={terms} textTerms={terms} linkVariant={boxVariantAttribute(item.boxVariant,protectedRow)==='card'?'button':'text'} transparent={visualId==='kanaler'&&i%3===2&&!surfaceAttribute(item.surface,protectedRow)}/>:<article class:list={['info-item data-[box-variant=plain]:p-(--panel-pad) data-[surface]:p-(--panel-pad)', `home-item-${i}`]} data-box-variant={boxVariantAttribute(item.boxVariant,protectedRow)} data-surface={surfaceAttribute(item.surface, protectedRow)??(visualId==='behov'?(['info','base-300','base-200'] as const)[i%3]:undefined)}>
      {section.id === 'mekanisme' && <span class="item-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
      <h3><TermText text={item.title} terms={terms} /></h3>{hasRichMarkdown(item.text)?<RichMarkdown text={item.text} variant="card"/>:<p>{item.text}</p>}{item.href && <a class="text-link" href={item.href}>{item.label || item.title}<Arrow diagonal /></a>}
    </article>)}</div>}
    {section.links && <div class="section-links">{section.links.map(link => <a class:list={['text-link', {'btn btn-primary':protectedRow||linkVariant==='button'}]} href={link.href}>{link.label}<Arrow /></a>)}</div>}
    <slot />
  </div>
</section>
