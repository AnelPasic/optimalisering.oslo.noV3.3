---
import MagnifyingGlass from '../assets/phosphor/magnifying-glass.svg';
import CursorClick from '../assets/phosphor/cursor-click.svg';
import ArrowsLeftRight from '../assets/phosphor/arrows-left-right.svg';
interface Props { kind?: 'search' | 'choose' | 'both'; }
const { kind = 'search' } = Astro.props;
const Icon = kind === 'search' ? MagnifyingGlass : kind === 'choose' ? CursorClick : ArrowsLeftRight;
---
<Icon class="home-symbol" aria-hidden="true" focusable="false" width="64" height="64" />
