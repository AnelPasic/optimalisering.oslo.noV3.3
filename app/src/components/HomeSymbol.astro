---
import MagnifyingGlass from '../assets/phosphor/magnifying-glass.svg';
import CursorClick from '../assets/phosphor/cursor-click.svg';
import TrendUp from '../assets/phosphor/trend-up.svg';
interface Props { kind?: 'search' | 'choose' | 'both'; }
const { kind = 'search' } = Astro.props;
const Icon = kind === 'search' ? MagnifyingGlass : kind === 'choose' ? CursorClick : TrendUp;
---
<Icon class="size-[34px] shrink-0" aria-hidden="true" focusable="false" width="34" height="34" />
