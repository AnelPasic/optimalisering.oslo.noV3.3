---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import Journey from './HomeJourney.astro';
import Leverage from './HomeLeverage.astro';
import ContentSection from './HomeSection.astro';
import Assessment from './HomeAssessment.astro';
import HomeSymbol from './HomeSymbol.astro';
interface Props { page: CollectionEntry<'pages'>['data']; }
const { page } = Astro.props;
const home = page.homepage!;
const assessment = page.sections.find(section => section.id === 'sjekk')!;
---
<div class="invite-home">
<section class="home-hero shell">
  <div class="hero-copy">
    <p class="eyebrow"><span class="small-dot"></span>{page.eyebrow}</p>
    <h1>{page.title}</h1>
    <p class="hero-display">{home.displayHook.map((line, index) => <span class={index === 0 ? 'hero-emphasis' : undefined}>{line}</span>)}</p>
    <p class="hero-intro">{page.intro}</p>
    <div class="hero-actions"><a class="button" href={page.cta.href}>{page.cta.label}<Arrow diagonal /></a><a class="text-link" href={home.secondaryCta.href}>{home.secondaryCta.label}<Arrow /></a></div>
    <p class="hero-note">{home.heroNote}</p>
  </div>
  <Journey content={home.illustration} />
</section>
<section id="behov" class="need-section section-space">
  <div class="shell">
    <h2>{home.selector.heading}</h2>
    <div class="need-grid">{home.selector.items.map((item, index) => <a class={`need-card need-card-${index}`} href={item.link.href}>
      <div class="home-card-top"><span class="discipline">{item.discipline}</span><HomeSymbol kind={index === 0 ? 'search' : index === 1 ? 'choose' : 'both'} /></div>
      <h3>{item.title}</h3><p>{item.description}</p><span class="text-link">{item.link.label}<Arrow diagonal /></span>
    </a>)}</div>
  </div>
</section>
<Leverage content={home.calculator} />
<section id="priser" class="package-section section-space">
  <div class="shell">
    <div class="section-heading"><p class="eyebrow">{home.packages.eyebrow}</p><h2>{home.packages.heading}</h2><p class="body-copy">{home.packages.intro}</p></div>
    <div class="package-grid">{home.packages.items.map((item, index) => <article class={`package-card package-card-${index}`}>
      <h3>{item.title}</h3>
      <dl><dt>{home.packages.fitLabel}</dt><dd>{item.fit}</dd><dt>{home.packages.scopeLabel}</dt><dd>{item.scope}</dd></dl>
      <div class="package-price"><p>{item.priceState}</p><p class="small-copy">{item.externalCosts}</p></div>
      <a class="button" href={item.cta.href}>{item.cta.label}<Arrow diagonal /></a>
    </article>)}</div>
  </div>
</section>
<!-- Proof slot is reserved in content/schema; no proof publication is authorized. -->
{page.sections.filter(section => ['mekanisme', 'passer'].includes(section.id)).map(section => <ContentSection section={section} />)}
<Assessment section={assessment} content={home.form} />
{page.sections.filter(section => section.id === 'medon').map(section => <ContentSection section={section} />)}
<section id="sporsmal" class="faq-section section-space"><div class="shell faq-grid"><div><p class="eyebrow">{home.faqEyebrow}</p><h2>{home.faqHeading}</h2></div><div class="faq-list">{page.faq.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>
</div>
