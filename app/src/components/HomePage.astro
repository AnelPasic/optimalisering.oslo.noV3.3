---
import '../styles/compositions/home.css';
import { getCollection,type CollectionEntry } from 'astro:content';
import CommercialHero from './CommercialHero.astro';
import {resolvePageHero} from '../lib/page-hero';
import HomepageBlock from './HomepageBlock.astro';
import Faq from './Faq.astro';
import { getHomepageBlocks, getHomepageBlock, isHomepageSectionVisible } from '../lib/home-builder';
import { getHeroProof } from '../lib/hero-proof';
interface Props { page: CollectionEntry<'pages'>['data']; }
const {page}=Astro.props;
const records=(await getCollection('proofCases')).map(record=>record.data);
const blocks=getHomepageBlocks(page);
---
<div class="invite-home">
 <CommercialHero content={resolvePageHero(page)} proof={isHomepageSectionVisible(getHomepageBlock(page,'proof'))?getHeroProof(getHomepageBlock(page,'proof').content,records):undefined} />
 {blocks.filter(isHomepageSectionVisible).map(block=><HomepageBlock block={block} records={records} faqItems={page.faq} />)}
 {!blocks.some(block => block._block==='faq' && isHomepageSectionVisible(block)) && <Faq id="sporsmal" items={page.faq} />}
</div>
