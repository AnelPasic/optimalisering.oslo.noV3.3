---
import type { CollectionEntry } from 'astro:content';
import { calculateScenario } from '../lib/leverage';
interface Props { content: NonNullable<CollectionEntry<'pages'>['data']['homepage']>['calculator']; }
const { content } = Astro.props;
const { labels, defaults } = content;
const result = calculateScenario(defaults.visits, defaults.conversion, defaults.trafficIncrease, defaults.newConversion);
const format = new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 1 });
const signed = new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 1, signDisplay: 'exceptZero' });
---
<section id="regneeksempel" class="leverage-section section-space">
  <div class="shell leverage-grid">
    <div class="leverage-copy"><p class="eyebrow">{content.eyebrow}</p><h2>{content.heading}</h2><p class="body-copy">{content.intro}</p><p class="calculator-formula">{content.formula}</p></div>
    <div class="leverage-tool" data-leverage data-undefined-increase={labels.undefinedIncrease} data-increase-label={labels.increase}>
      <div class="calculator-inputs">
        <label for="calc-visits">{labels.visits}<input id="calc-visits" name="visits" type="number" min="0" max="10000000" step="1" value={defaults.visits} inputmode="numeric" aria-describedby="calculator-error" /></label>
        <label for="calc-conversion">{labels.conversion}<input id="calc-conversion" name="conversion" type="number" min="0" max="100" step="any" value={defaults.conversion} inputmode="decimal" aria-describedby="calculator-error" /></label>
        <label for="calc-traffic">{labels.trafficIncrease}<input id="calc-traffic" name="trafficIncrease" type="number" min="0" max="1000" step="any" value={defaults.trafficIncrease} inputmode="decimal" aria-describedby="calculator-error" /></label>
        <label for="calc-new-conversion">{labels.newConversion}<input id="calc-new-conversion" name="newConversion" type="number" min="0" max="100" step="any" value={defaults.newConversion} inputmode="decimal" aria-describedby="calculator-error" /></label>
      </div>
      <p id="calculator-error" class="calculator-error" role="status" hidden>{labels.invalid}</p>
      <div class="calculator-results" role="status" aria-live="polite" aria-atomic="true">
        <div class="math-results">
          <div class="leverage-result"><span>{labels.current}</span><output data-current>{format.format(result.current)}</output><span class="outcome-label">{labels.outcome}</span><span class="math-equation" data-current-equation>{format.format(defaults.visits)} × {String(defaults.conversion).replace('.', ',')} %</span></div>
          <div class="leverage-comparison"><span>{labels.scenario}</span><output data-scenario>{format.format(result.scenario)}</output><span class="outcome-label">{labels.outcome}</span><span class="math-equation" data-scenario-equation>{format.format(result.scenarioVisits)} × {String(defaults.newConversion).replace('.', ',')} %</span></div>
        </div>
        <p class="calculator-difference">{labels.difference}: <output data-difference>{signed.format(result.difference)}</output><span data-percentage>{result.increase === null ? labels.undefinedIncrease : `${signed.format(result.increase)} % ${labels.increase}`}</span></p>
      </div>
      <p class="calculator-caveat">{content.caveat}</p>
    </div>
  </div>
</section>
<script>
  import { calculateScenario } from '../lib/leverage';
  const tool = document.querySelector<HTMLElement>('[data-leverage]');
  if (tool) {
    const inputs = ['visits', 'conversion', 'trafficIncrease', 'newConversion'].map(name => tool.querySelector<HTMLInputElement>(`[name="${name}"]`)!);
    const current = tool.querySelector<HTMLOutputElement>('[data-current]')!;
    const scenario = tool.querySelector<HTMLOutputElement>('[data-scenario]')!;
    const difference = tool.querySelector<HTMLOutputElement>('[data-difference]')!;
    const percentage = tool.querySelector<HTMLElement>('[data-percentage]')!;
    const currentEquation = tool.querySelector<HTMLElement>('[data-current-equation]')!;
    const scenarioEquation = tool.querySelector<HTMLElement>('[data-scenario-equation]')!;
    const error = tool.querySelector<HTMLElement>('#calculator-error')!;
    const format = new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 1 });
    const signed = new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 1, signDisplay: 'exceptZero' });
    function update() {
      const valid = inputs.every(input => input.value !== '' && input.checkValidity());
      inputs.forEach(input => input.setAttribute('aria-invalid', String(input.value === '' || !input.checkValidity())));
      error.hidden = valid;
      if (!valid) {
        [current, scenario, difference, percentage, currentEquation, scenarioEquation].forEach(output => output.textContent = '–');
        return;
      }
      const [visits, conversion, traffic, newConversion] = inputs.map(input => Number(input.value));
      const result = calculateScenario(visits, conversion, traffic, newConversion);
      current.value = format.format(result.current);
      scenario.value = format.format(result.scenario);
      [current, scenario].forEach(output => output.style.setProperty('--result-size', `${Math.max(16, Math.min(64, 145 / output.value.length))}px`));
      difference.value = signed.format(result.difference);
      percentage.textContent = result.increase === null ? tool!.dataset.undefinedIncrease! : `${signed.format(result.increase)} % ${tool!.dataset.increaseLabel}`;
      currentEquation.textContent = `${format.format(visits)} × ${inputs[1].value.replace('.', ',')} %`;
      scenarioEquation.textContent = `${format.format(result.scenarioVisits)} × ${inputs[3].value.replace('.', ',')} %`;
    }
    inputs.forEach(input => input.addEventListener('input', update));
    update();
  }
</script>
