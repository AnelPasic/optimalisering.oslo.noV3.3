---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; index?: number; }
const { section, index = 0 } = Astro.props;
---
<section id={section.id} class:list={['content-section section-space', { 'section-tint': index % 3 === 1 }]}>
  <div class="shell">
    <div class:list={['section-heading', { 'section-heading-split': section.body.length > 0 }]}><div>{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}<h2>{section.heading}</h2></div><div class="body-copy">{section.body.map(text => <p>{text}</p>)}</div></div>
    {section.items && <div class:list={['section-items', { 'two-items': section.items.length === 2, 'process-items': section.id === 'sjekk' }]}>{section.items.map((item, i) => <article class:list={['info-item', { 'item-apricot': i === 0, 'item-sage': i === 1, 'item-plain': i > 1 }]}><span class="item-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p>{item.href && <a class="text-link" href={item.href}>{item.label || item.title}<Arrow diagonal /></a>}</article>)}</div>}
    {section.links && <div class="section-links">{section.links.map(link => <a class="text-link" href={link.href}>{link.label}<Arrow /></a>)}</div>}
  </div>
</section>
