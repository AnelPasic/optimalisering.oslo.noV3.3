---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import { sectionDefaultsAt } from '../lib/section-appearance';
import { actionClasses, buttonChoice } from '../lib/section-buttons';
import TermText from './TermText.astro';
import ContentCard from './ContentCard.astro';
import RichMarkdown from './RichMarkdown.astro';
import {hasRichMarkdown} from '../lib/rich-markdown';
import { resolveSectionSurface, surfaceAttribute } from '../lib/surface';
import { siteChrome as chrome } from '../lib/site-chrome-data';
import { resolveHeadingAlignment } from '../lib/heading-alignment';
import {contentLayoutAttribute,paragraphLayoutAttribute} from '../lib/content-presentation';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; index?: number; }
const { section, index } = Astro.props;
const terms = Astro.url.pathname === '/nettbutikkoptimalisering/' ? ['checkout', 'ordreverdi', 'margin', 'konverteringsrate'] : Astro.url.pathname === '/seo/' ? ['seo'] : Astro.url.pathname === '/ai-synlighet/' ? ['ai-synlighet', 'aeo', 'aio', 'geo', 'seo'] : [];
const protectedRow = section._block === 'protected';
const defaults = sectionDefaultsAt(chrome, index);
const sectionButton = protectedRow ? undefined : buttonChoice(section.buttonStyle, defaults?.buttonStyle);
const boxButton = protectedRow ? undefined : buttonChoice(section.boxButtonStyle, defaults?.boxButtonStyle);
const alignment = resolveHeadingAlignment(section.headingAlign, defaults?.headingAlign);
---
<section id={section.id} class:list={['content-section section-space', { 'section-tint': (index ?? 0) % 3 === 1 }]} data-surface={resolveSectionSurface(section.surface, defaults?.surface, protectedRow)}>
  <div class="shell">
    <div class="section-heading" data-heading-align={alignment}><div>{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}<h2>{section.heading}</h2></div><div class="body-copy" data-content-layout={paragraphLayoutAttribute(section,section._block === 'protected')}>{section.body.map(text => hasRichMarkdown(text)?<RichMarkdown text={text}/>:<p><TermText text={text} terms={terms} /></p>)}</div></div>
    {section.items && <div class:list={['section-items', { 'two-items': section.items.length === 2, 'process-items': section.id === 'sjekk' }]} data-content-layout={contentLayoutAttribute(section.layout,section._block==='protected')}>
      {section.items.map((item, i) => <ContentCard
        iconName={item.iconName}
        badge={item.badge}
        badgeClass={item.badgeClass}
        buttonStyle={buttonChoice(item.buttonStyle, boxButton)}
        title={item.title}
        text={item.text}
        surface={surfaceAttribute(item.surface, protectedRow) ?? (i === 0 ? 'base-300' : 'base-100')}
        transparent={i > 0 && !surfaceAttribute(item.surface, protectedRow)}
        number={String(i + 1).padStart(2, '0')}
        href={item.href}
        label={item.label}
        textTerms={terms}
      />)}
    </div>}
    {section.links && <div class:list={['section-links', alignment === 'center' ? 'justify-center' : 'justify-start']}>{section.links.map(link => <a class={actionClasses(sectionButton ?? 'link')} href={link.href}>{link.label}<Arrow /></a>)}</div>}
  </div>
</section>
