---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import TermText from './TermText.astro';
import { surfaceAttribute } from '../lib/surface';
import { headingAlignAttribute } from '../lib/heading-alignment';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; index?: number; }
const { section, index = 0 } = Astro.props;
const terms = Astro.url.pathname === '/nettbutikkoptimalisering/' ? ['checkout', 'ordreverdi', 'margin', 'konverteringsrate'] : Astro.url.pathname === '/seo/' ? ['seo'] : Astro.url.pathname === '/ai-synlighet/' ? ['ai-synlighet', 'aeo', 'aio', 'geo', 'seo'] : [];
---
<section id={section.id} class:list={['content-section section-space', { 'section-tint': index % 3 === 1 }]} data-surface={surfaceAttribute(section.surface, section._block === 'protected')}>
  <div class="shell">
    <div class="section-heading" data-heading-align={headingAlignAttribute(section.headingAlign)}><div>{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}<h2>{section.heading}</h2></div><div class="body-copy">{section.body.map(text => <p><TermText text={text} terms={terms} /></p>)}</div></div>
    {section.items && <div class:list={['section-items', { 'two-items': section.items.length === 2, 'process-items': section.id === 'sjekk' }]}>{section.items.map((item, i) => <article class:list={['info-item', { 'item-apricot': i === 0, 'item-sage': i === 1, 'item-plain': i > 1 }]} data-surface={surfaceAttribute(item.surface, section._block === 'protected')}><span class="item-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p><TermText text={item.text} terms={terms} /></p>{item.href && <a class="text-link" href={item.href}>{item.label || item.title}<Arrow diagonal /></a>}</article>)}</div>}
    {section.links && <div class="section-links">{section.links.map(link => <a class="text-link" href={link.href}>{link.label}<Arrow /></a>)}</div>}
  </div>
</section>
