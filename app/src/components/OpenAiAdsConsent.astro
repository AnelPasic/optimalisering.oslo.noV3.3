<aside
  data-openai-ads-consent
  hidden
  role="region"
  aria-labelledby="openai-ads-consent-heading"
  class="fixed inset-x-4 bottom-4 z-[200] mx-auto max-w-[700px] rounded-xl border border-base-300 bg-base-100 p-4 text-base-content shadow-xl"
>
  <h2 id="openai-ads-consent-heading" class="text-lg font-semibold">Måling av ChatGPT-annonser</h2>
  <p class="mt-2 text-sm leading-relaxed">
    Vi ønsker å bruke OpenAIs målepiksel for å se om annonser fører til besøk og henvendelser.
    Hvis du godtar, kan OpenAI motta opplysninger om sidebesøk og målehendelser og lagre
    informasjonskapsler. Ingen slik sporing starter før du godtar.
    Du kan endre valget når som helst.
  </p>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button type="button" class="btn btn-outline" data-openai-ads-reject>Avslå måling</button>
    <button type="button" class="btn btn-outline" data-openai-ads-accept>Tillat måling</button>
    <a class="text-sm underline underline-offset-2" href="/personvern/#annonsemaaling">Les om personvern</a>
  </div>
</aside>

<script>
  type ConsentApi = {
    getChoice: () => "yes" | "no" | null;
    setChoice: (choice: "yes" | "no") => void;
  };
  const api = (window as Window & { OptimaliseringOpenAIAds?: ConsentApi }).OptimaliseringOpenAIAds;
  const panel = document.querySelector<HTMLElement>('[data-openai-ads-consent]');
  if (api && panel) {
    const showIfUndecided = () => { panel.hidden = api.getChoice() !== null; };
    const pick = (choice: "yes" | "no") => { api.setChoice(choice); panel.hidden = true; };
    panel.querySelector<HTMLButtonElement>('[data-openai-ads-reject]')?.addEventListener('click', () => pick('no'));
    panel.querySelector<HTMLButtonElement>('[data-openai-ads-accept]')?.addEventListener('click', () => pick('yes'));
    document.querySelectorAll<HTMLButtonElement>('[data-openai-ads-manage]').forEach(button => {
      button.addEventListener('click', () => {
        panel.hidden = false;
        panel.querySelector<HTMLButtonElement>('[data-openai-ads-reject]')?.focus();
      });
    });
    window.addEventListener('optimalisering:ads-consent-changed', showIfUndecided);
    showIfUndecided();
  }
</script>

<style>
  [data-openai-ads-consent][hidden] { display: none !important; }
</style>
