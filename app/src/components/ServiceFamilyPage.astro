---
import type { HomepageContent } from '../lib/home-section-data';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import type { RouteFamily } from '../lib/route-family';
import CommercialHero from './CommercialHero.astro';
import {resolvePageHero} from '../lib/page-hero';
import ContentSection from './HomeSection.astro';
import Proof from './HomeProof.astro';
import PricingBridge from './ServicePricingBridge.astro';
import Faq from './Faq.astro';
import ClosingCta from './ClosingCta.astro';
import { visibleServiceSections, hasGlobalServiceProof, validateServiceGlobalProof } from '../lib/service-sections';
import GlobalContentSection from './GlobalContentSection.astro';
import '../styles/compositions/service.css';
interface Props {page:CollectionEntry<'pages'>['data'];commercial:HomepageContent;route:RouteFamily;}
const {page,commercial,route}=Astro.props;
const cmsOnly=page.slug==='synlighet';
const capability=route.service,bridge=capability.pricingBridge;
const globalProof=hasGlobalServiceProof(page);
const hasGlobalFaq=page.sections.some(section=>section.globalElement==='sporsmal');
const records=(!cmsOnly&&capability.proofAfter)||globalProof?(await getCollection('proofCases')).map(p=>p.data):[];
validateServiceGlobalProof(page,records);
---
<div class="invite-home invite-service">
  <CommercialHero content={resolvePageHero(page)} />
  {visibleServiceSections(page).map(section=><>
    {section.globalElement ? <GlobalContentSection element={section.globalElement} /> : <>
    <ContentSection section={section} visualId={capability.sectionVisuals.find(v=>v.section===section.id)?.visual} defaultSurface={capability.sectionSurfaces.find(v=>v.section===section.id)?.surface} />
    {!cmsOnly&&!globalProof&&capability.proofAfter===section.id&&page.proof&&<Proof content={page.proof} records={records} primary />}
    {!cmsOnly&&bridge?.after===section.id&&<PricingBridge content={commercial.packages} link={bridge.link} serviceName={bridge.serviceName} />}
    </>}
  </>)}
  {!cmsOnly&&!hasGlobalFaq&&<Faq items={page.faq} id="sporsmal" heading={capability.closingCta||commercial.faqVisible===false?undefined:commercial.faqHeading} eyebrow={capability.closingCta||commercial.faqVisible===false?undefined:commercial.faqEyebrow} />}
  {!cmsOnly&&capability.closingCta&&!visibleServiceSections(page).some(section=>section.globalElement==='sjekk')&&<ClosingCta link={page.cta} />}
</div>
