---
import type { CollectionEntry } from 'astro:content';
import AssessmentForm from './AssessmentForm.astro';
import Arrow from './Arrow.astro';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; }
const { section } = Astro.props;
---
<section id={section.id} class="assessment-section section-space"><div class="shell assessment-grid"><div class="assessment-copy"><p class="eyebrow">{section.eyebrow}</p><h2>{section.heading}</h2>{section.body.map(text => <p>{text}</p>)}<div class="form-process">{section.items?.map(item => <div><h3>{item.title}</h3><p>{item.text}</p></div>)}</div><div class="section-links">{section.links?.map(link => <a class="text-link" href={link.href}>{link.label}<Arrow /></a>)}</div></div><AssessmentForm /></div></section>
