---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import ClosingCta from './ClosingCta.astro';
import ContentSection from './HomeSection.astro';
import Faq from './Faq.astro';
import PageList from './PageList.astro';
import '../styles/compositions/service.css';
interface Props { page: CollectionEntry<'pages'>['data']; pages: CollectionEntry<'pages'>['data'][]; }
const { page, pages } = Astro.props;
---
<div class="invite-home invite-service">
  <section class="service-hero shell">
    <nav class="breadcrumbs" aria-label="Brødsmuler"><a href="/">Forsiden</a><span aria-hidden="true">/</span><span>{page.eyebrow}</span></nav>
    <p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="hero-intro">{page.intro}</p>
    <div class="hero-actions"><a class="button btn btn-primary" href={page.cta.href}>{page.cta.label}<Arrow diagonal /></a></div>
  </section>
  {page.sections.map(section => section._block === 'pageList' ? <PageList section={section} pages={pages} /> : <ContentSection section={section} />)}
  <Faq items={page.faq} />
  <ClosingCta link={page.cta} />
</div>
