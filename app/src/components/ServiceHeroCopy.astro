---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props { page: CollectionEntry<'pages'>['data']; pricingLink?: { label: string; href: string }; }
const { page, pricingLink } = Astro.props;
---
<p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="hero-intro">{page.intro}</p>
<div class="hero-actions"><a class="button btn btn-primary" href={page.cta.href}>{page.cta.label}<Arrow diagonal /></a>{pricingLink&&<a class="text-link" href={pricingLink.href}>Se priser<Arrow /></a>}</div>
