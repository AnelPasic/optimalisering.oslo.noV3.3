---
import type { CardDecoration } from '../lib/card-decoration';
import CardBadge from './CardBadge.astro';
import PhosphorIcon from './PhosphorIcon.astro';

interface Props extends CardDecoration { title?: string; badgeCheck?: boolean; }
const { iconName, badge, badgeClass, title, badgeCheck = false } = Astro.props;
const badgeStyle = 'badge-sm min-h-5 py-1';
---
{(title || iconName || badge?.trim()) && <div class:list={['flex min-w-0 justify-between', title
  ? 'mb-[26px] items-center gap-(--gap-sm) max-[900px]:mb-[18px]'
  : 'items-start gap-3']} data-card-decorations>
  {title
    ? <div class="flex min-w-0 flex-col items-start gap-2">
        <span class="text-(length:--type-body) font-semibold leading-(--leading-body)" data-card-topline>{title}</span>
        <CardBadge text={badge} badgeClass={badgeClass} class:list={[badgeStyle, badgeCheck && 'border-current']}>
          {badgeCheck && <svg class="size-[1em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10" /><polyline points="7 13 10 16 17 8" />
          </svg>}
        </CardBadge>
      </div>
    : <CardBadge text={badge} badgeClass={badgeClass} class={badgeStyle} />}
  {iconName
    ? <PhosphorIcon name={iconName} class:list={['ml-auto shrink-0', title ? 'size-[34px]' : 'size-6']} size={title ? 34 : 24} />
    : <slot name="icon" />}
</div>}
