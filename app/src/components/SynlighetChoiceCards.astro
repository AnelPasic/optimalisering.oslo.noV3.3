---
import type { CollectionEntry } from 'astro:content';
import { getGlobalElement } from '../lib/home-builder';
import { surfaceAttribute, surfaceClasses } from '../lib/surface';
import HomeSymbol from './HomeSymbol.astro';
import Arrow from './Arrow.astro';

type Item = NonNullable<CollectionEntry<'pages'>['data']['sections'][number]['items']>[number];
interface Props { items: Item[]; }
const { items } = Astro.props;

// One commercial authority: the monthly price is edited in Pages CMS
// under Global Innhold -> Pakker og priser, never duplicated on this page.
const offer = getGlobalElement('priser').content.items.find(item => item.key === 'optimalisering');
if (!offer) throw new Error('Synlighet choice cards require the Optimalisering package');
const price = [
  new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 0 }).format(offer.price),
  offer.priceSuffix,
  offer.vatSuffix,
].filter(Boolean).join(' ');
const backgrounds = ['info', 'base-300', 'secondary'] as const;
---
<div class="mt-[44px] grid grid-cols-3 gap-(--gap-lg) max-[900px]:grid-cols-1 max-[650px]:mt-8 max-[650px]:gap-(--gap)">
  {items.map((item, index) => (
    <a
      data-home-selector-card
      class:list={['card min-w-0 border border-transparent no-underline transition-[border-color] duration-150 hover:border-primary', surfaceClasses(surfaceAttribute(item.surface) ?? backgrounds[index % backgrounds.length])]}
      href={item.href ?? '/priser/?pakke=optimalisering#bestill'}
    >
      <div class="card-body min-w-0 gap-0 p-(--panel-pad-lg) max-[1100px]:p-(--panel-pad)">
        <div class="mb-[26px] flex items-center justify-between gap-(--gap-sm) max-[900px]:mb-[18px]">
          <span class="text-(length:--type-body) font-semibold leading-(--leading-body)">{item.title} · {price}</span>
          <HomeSymbol kind={index === 0 ? 'search' : index === 1 ? 'choose' : 'both'} />
        </div>
        <h3 class="max-w-[390px] max-[900px]:max-w-[600px]">{item.headline ?? item.title}</h3>
        <p class="mt-[18px] mb-5 grow-0 break-words text-(length:--type-body) leading-(--leading-body) text-inherit">{item.text}</p>
        <div class="card-actions mt-auto">
          <span class="text-link">{item.label ?? 'Se pakken'}<Arrow diagonal /></span>
        </div>
      </div>
    </a>
  ))}
</div>
