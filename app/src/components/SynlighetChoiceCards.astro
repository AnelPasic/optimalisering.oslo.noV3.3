---
import EditorialText from './EditorialText.astro';
import type { CollectionEntry } from 'astro:content';
import { surfaceAttribute, surfaceClasses } from '../lib/surface';
import Arrow from './Arrow.astro';
import PhosphorIcon from './PhosphorIcon.astro';

type Item = NonNullable<CollectionEntry<'pages'>['data']['sections'][number]['items']>[number];
interface Props { items: Item[]; }
const { items } = Astro.props;

const backgrounds = ['info', 'base-300', 'secondary'] as const;
---
<div class="mt-[44px] grid grid-cols-3 gap-(--gap-lg) max-[900px]:grid-cols-1 max-[650px]:mt-8 max-[650px]:gap-(--gap)">
  {items.map((item, index) => {
    const badgeClass = item.badgeClass ?? (item.badge === 'Inkludert i alle pakker' ? 'badge-success' : 'badge-outline');
    return (
    <article
      data-home-selector-card
      class:list={['card relative min-w-0 border border-transparent transition-[border-color] duration-150 hover:border-primary', surfaceClasses(surfaceAttribute(item.surface) ?? backgrounds[index % backgrounds.length])]}
    >
      {item.href && <a
        data-card-detail-link
        href={item.href}
        aria-label={`Les om ${item.title}`}
        class="absolute inset-0 z-10 rounded-[inherit] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      ></a>}
      <div class="card-body min-w-0 gap-0 p-(--panel-pad-lg) max-[1100px]:p-(--panel-pad)">
        <div class="mb-[26px] flex items-center justify-between gap-(--gap-sm) max-[900px]:mb-[18px]">
          <div class="flex min-w-0 flex-col items-start gap-2">
            <span class="text-(length:--type-body) font-semibold leading-(--leading-body)">{item.title}</span>
            {item.badge && <span
              class:list={['badge', badgeClass !== 'badge' && badgeClass, 'badge-sm h-auto min-h-5 max-w-full whitespace-normal border-current py-1', badgeClass === 'badge-outline' && 'text-inherit']}
              data-card-badge>
              {item.badge === 'Inkludert i alle pakker' && (
                <svg class="size-[1em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <g fill="currentColor" stroke-linejoin="miter" stroke-linecap="butt">
                    <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-linecap="square" stroke-miterlimit="10" stroke-width="2"></circle>
                    <polyline points="7 13 10 16 17 8" fill="none" stroke="currentColor" stroke-linecap="square" stroke-miterlimit="10" stroke-width="2"></polyline>
                  </g>
                </svg>
              )}
              {item.badge}
            </span>}
          </div>
          <PhosphorIcon name={item.iconName} class="size-[34px] shrink-0" size={34} />
        </div>
        <h3 class="max-w-[390px] max-[900px]:max-w-[600px]">{item.headline ?? item.title}</h3>
        <EditorialText class="mt-[18px] mb-5 grow-0 break-words text-(length:--type-body) leading-(--leading-body) text-inherit [&_a]:relative [&_a]:z-20" text={item.text} />
        <div class="card-actions relative z-20 mt-auto">
          <a data-card-order-link href="#bestill" class="text-link">{item.label ?? 'Velg tjeneste'}<Arrow diagonal /></a>
        </div>
      </div>
    </article>
    );
  })}
</div>
