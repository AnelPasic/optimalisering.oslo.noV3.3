---
import { resolvePackageAsset, type PackageAsset } from '../lib/package-visual';
interface Props { kind: 'controlled' | 'accelerating' | 'tracks'; asset?: PackageAsset; }
const { kind, asset } = Astro.props;
const supplied = resolvePackageAsset(asset);
const curves = {
  controlled: ['M22 108 C138 100 288 80 454 60'],
  accelerating: ['M22 117 C216 117 276 112 339 87 S426 45 454 16'],
  tracks: ['M22 104 C160 104 280 67 454 10', 'M22 120 C176 120 302 84 454 36', 'M22 136 C192 136 320 101 454 62'],
};
---
<div class={`package-visual-area package-visual-area-${kind}`} data-supplied={String(Boolean(supplied))}>
{supplied ? <img class="package-visual-asset" src={supplied.src} alt={supplied.alt} loading="lazy" decoding="async" width="640" height="480" data-vector={String(supplied.src.endsWith('.svg'))} style={{ objectPosition: `${supplied.positionX ?? 50}% ${supplied.positionY ?? 50}%` }} /> : <svg class={`package-visual package-visual-${kind}`} viewBox="0 0 480 148" fill="none" aria-hidden="true" focusable="false">
  {curves[kind].map((curve, index) => <g><path class="package-curve" d={curve} stroke="currentColor" stroke-width="4" stroke-linecap="round" /><path d={kind === 'controlled' ? 'm442 54 14 5-8 12' : kind === 'accelerating' ? 'm442 23 12-9 3 15' : ['m442 6 14 3-7 12', 'm442 32 14 3-7 12', 'm442 58 14 3-7 12'][index]} stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></g>)}
</svg>}
</div>
