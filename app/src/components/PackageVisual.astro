---
import { resolvePackageAsset, type PackageAsset } from '../lib/package-visual';
import Motif from './PackageMotif.astro';
interface Props {
  kind: 'controlled' | 'accelerating' | 'tracks';
  motifId: string;
  svg?: string;
  asset?: PackageAsset;
  caption?: { label: string; support?: string };
}
const { kind, motifId, svg, asset, caption } = Astro.props;
// Keep the CMS SVG in image context, where browsers disable scripts and external resources.
const animation = svg ? `data:image/svg+xml,${encodeURIComponent(svg)}` : undefined;
const supplied = animation ? undefined : resolvePackageAsset(asset);
---
<div class={`package-visual-area package-visual-area-${kind}`} data-supplied={String(Boolean(supplied))} data-editorial={String(!supplied && !animation)} data-animation={String(Boolean(animation))}>
  {supplied ? (
    <img class="package-visual-asset" src={supplied.src} alt={supplied.alt} loading="lazy" decoding="async" width="640" height="480" data-vector={String(supplied.src.endsWith('.svg'))} style={{ objectPosition: `${supplied.positionX ?? 50}% ${supplied.positionY ?? 50}%` }} />
  ) : (
    <div class:list={['package-infographic', { 'has-caption': Boolean(caption) }]}>
      {animation ? <img class="package-animation" src={animation} alt="" width="320" height="180" data-package-animation /> : <Motif kind={kind} id={motifId} />}
      {caption && (
        <div class="package-visual-caption">
          <p>{caption.label}</p>
          {caption.support && <p>{caption.support}</p>}
        </div>
      )}
    </div>
  )}
</div>

<script>
  if ('IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        if (isIntersecting && target instanceof HTMLImageElement) {
          target.src += '#play';
          observer.unobserve(target);
        }
      }
    }, { threshold: 0.15 });

    document.querySelectorAll('img[data-package-animation]').forEach(image => observer.observe(image));
  }
</script>
