---
import EditorialText from './EditorialText.astro';
import type {HomepageContent} from '../lib/home-section-data';
interface Props {packages: HomepageContent['packages']}
const {packages}=Astro.props;
---
<section id="pricing-multiplier" class="pricing-multiplier section-space">
  <div class="shell">
    <h2>{packages.multiplier.heading}</h2>
    <p class="multiplier-row">{packages.multiplier.conceptualRow}</p>
    <details class="multiplier-detail"><summary>{packages.multiplier.eyebrow}</summary><EditorialText class="body-copy" text={packages.multiplier.body} /><EditorialText class="body-copy" text={packages.multiplier.support} /></details>
  </div>
</section>
