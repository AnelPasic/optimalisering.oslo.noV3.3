---
import type { CollectionEntry } from 'astro:content';
import HomeSection from './HomeSection.astro';
import Arrow from './Arrow.astro';
import ListingVisual from './ListingVisual.astro';
import { resolvePageList, pageListPresentationVisual, type ListPage } from '../lib/page-list';
import { getCollection } from 'astro:content';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; pages?: readonly ListPage[]; }
const { section, pages: suppliedPages } = Astro.props;
const config = section.pageList!;
const pages = suppliedPages ?? (await getCollection('pages')).map(entry=>entry.data);
const cases = config.source === 'cases' || config.mode === 'manual' ? (await getCollection('proofCases')).map(entry=>entry.data) : [];
const items = resolvePageList(config, pages, 'public', cases);
const cards = items.map(item => ({ title: item.title, text: item.summary, href: item.href, label: item.label, surface: 'default' as const, boxVariant: 'default' as const }));
const displayedItems = items.map(item => ({ ...item, displayVisual: pageListPresentationVisual(item, config.layout) }));
---
{config.layout === 'cards' ? <HomeSection section={{ ...section, items: cards }} /> :
  <HomeSection section={section}>
    <ul class:list={['page-list', `page-list-${config.layout}`]} data-count={items.length}>
      {displayedItems.map(item => <li>
        {config.layout === 'mediaCards' || config.layout === 'alternating' ?
          <article class:list={['listing-item min-w-0',config.layout === 'mediaCards'?'card card-border bg-base-100 h-full overflow-hidden':'info-item']} data-has-visual={!!item.displayVisual} data-visual-kind={item.displayVisual?.kind ?? 'none'} data-surface={config.layout === 'mediaCards' ? 'base-100' : undefined}>
            {config.layout === 'mediaCards' && item.displayVisual && <figure class="listing-media"><ListingVisual visual={item.displayVisual} /></figure>}
            <div class:list={['listing-copy',config.layout === 'mediaCards'&&'card-body min-w-0 flex-1 items-start gap-0']}>
              <h3 class:list={[config.layout === 'mediaCards'&&'card-title mb-4 text-[length:var(--type-h3)] leading-[var(--leading-h3)]']}>{item.title}</h3>
              <p class:list={[config.layout === 'mediaCards'&&'mb-6 text-base-content']}>{item.summary}</p>
              {item.href&&(config.layout === 'mediaCards'?<div class="card-actions mt-auto"><a class="text-link text-base-content" href={item.href}>{item.label}<Arrow diagonal /></a></div>:<a class="text-link" href={item.href}>{item.label}<Arrow diagonal /></a>)}
            </div>
            {config.layout === 'alternating' && item.displayVisual && <ListingVisual visual={item.displayVisual} />}
          </article> : config.layout === 'links' ? (item.href ? <a class="text-link" href={item.href}>{item.title}<Arrow diagonal /></a> : <span class="font-semibold">{item.title}</span>) :
          <article class="info-item page-list-row"><h3>{item.title}</h3><p>{item.summary}</p>{item.href&&<a class="text-link" href={item.href}>{item.label}<Arrow diagonal /></a>}</article>}
      </li>)}
    </ul>
  </HomeSection>}
<style>
  .page-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--gap); }
  .page-list li { min-width: 0; }
  .page-list .page-list-row { padding: var(--panel-pad-sm) 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
  .page-list-alternating .listing-item { padding: 0; border: 0; min-width: 0; }
  .listing-copy { min-width: 0; }
  .listing-copy .text-link { margin-top: var(--gap); }
  .page-list-alternating { gap: clamp(48px, 5vw, 80px); margin-top: var(--gap-lg); }
  .page-list-alternating .listing-item { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .page-list-alternating .listing-item[data-visual-kind="icon"] :global(.listing-visual) { aspect-ratio: auto; height: clamp(180px, 18vw, 240px); }
  @media (min-width: 701px) {
    .page-list-alternating .listing-item[data-visual-kind="icon"] { grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); }
    .page-list-alternating > li:nth-child(even) .listing-item[data-visual-kind="icon"] { grid-template-columns: minmax(0, 3fr) minmax(0, 7fr); }
  }
  .page-list-alternating > li:nth-child(even) .listing-copy { grid-column: 2; grid-row: 1; }
  .page-list-alternating > li:nth-child(even) :global(.listing-visual) { grid-column: 1; grid-row: 1; }
  .page-list-alternating > li:nth-child(even) :global(.listing-visual[data-kind="icon"]) { background: var(--color-info); }
  .page-list-mediaCards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin-top: var(--gap-lg); }
  .page-list-mediaCards[data-count="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .page-list-mediaCards[data-count="1"] { grid-template-columns: minmax(0, 1fr); }
  .page-list-mediaCards :global(.listing-visual) { aspect-ratio: 3 / 2; border-radius: 0; }
  @media (max-width: 1100px) { .page-list-mediaCards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .page-list-mediaCards, .page-list-mediaCards[data-count="2"] { grid-template-columns: minmax(0, 1fr); }
    .page-list-alternating .listing-item { grid-template-columns: minmax(0, 1fr); gap: var(--gap); }
    .page-list-alternating .listing-item[data-visual-kind="icon"] :global(.listing-visual) { height: clamp(140px, 40vw, 180px); }
    .page-list-alternating > li:nth-child(even) .listing-copy, .page-list-alternating > li:nth-child(even) :global(.listing-visual) { grid-column: auto; grid-row: auto; }
  }
</style>
