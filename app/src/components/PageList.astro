---
import type { CollectionEntry } from 'astro:content';
import HomeSection from './HomeSection.astro';
import Arrow from './Arrow.astro';
import { resolvePageList, type ListPage } from '../lib/page-list';
interface Props { section: CollectionEntry<'pages'>['data']['sections'][number]; pages: readonly ListPage[]; }
const { section, pages } = Astro.props;
const config = section.pageList!;
const items = resolvePageList(config, pages);
const cards = items.map(item => ({ title: item.title, text: item.summary, href: item.href, label: item.label, surface: 'default' as const }));
---
{config.layout === 'cards' ? <HomeSection section={{ ...section, items: cards }} /> :
  <HomeSection section={section}>
    <ul class:list={['page-list', `page-list-${config.layout}`]}>
      {items.map(item => <li>
        {config.layout === 'links' ? <a class="text-link" href={item.href}>{item.title}<Arrow diagonal /></a> :
          <article class="info-item page-list-row"><h3>{item.title}</h3><p>{item.summary}</p><a class="text-link" href={item.href}>{item.label}<Arrow diagonal /></a></article>}
      </li>)}
    </ul>
  </HomeSection>}
<style>
  .page-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--gap); }
  .page-list li { min-width: 0; }
  .page-list .page-list-row { padding: var(--panel-pad-sm) 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
</style>
