---
import Arrow from './Arrow.astro';
import CardDecorations from './CardDecorations.astro';
import { resolveCardImage, type CardImage } from '../lib/card-image';
import PhosphorIcon from './PhosphorIcon.astro';
import type { CardDecoration } from '../lib/card-decoration';
import { actionClasses, buttonChoice, type ButtonStyle } from '../lib/section-buttons';
import TermText from './TermText.astro';
import RichMarkdown from './RichMarkdown.astro';
import { hasRichMarkdown } from '../lib/rich-markdown';
import { surfaceAttribute, surfaceClasses, type Surface } from '../lib/surface';

interface Props extends CardDecoration {
  title: string;
  headline?: string;
  image?: CardImage;
  text: string;
  surface?: Surface;
  number?: string;
  href?: string;
  label?: string;
  titleTerms?: string[];
  textTerms?: string[];
  linkVariant?: 'button' | 'text';
  buttonStyle?: ButtonStyle;
  transparent?: boolean;
  detailHref?: string;
  choice?: boolean;
  badgeCheck?: boolean;
}
const { title, headline, text, surface, number, href, label, iconName, badge, badgeClass,
  titleTerms = [], textTerms = [], linkVariant = 'button', buttonStyle, transparent = false, detailHref, choice = false, badgeCheck = false } = Astro.props;
const heading = headline?.trim();
const image = resolveCardImage(Astro.props.image);
const iconBesideTitle = !heading && !badge?.trim() && Boolean(iconName || Astro.slots.has('icon'));
const selected = surfaceAttribute(surface) ?? 'base-100';
const action = buttonChoice(buttonStyle) ?? (linkVariant === 'text' ? 'link' : 'btn');
const bodyClass = 'text-(length:--type-body) leading-(--leading-body)';
---
<article class:list={['card min-w-0 wrap-anywhere',
  transparent ? 'bg-transparent card-border border-base-300' : surfaceClasses(selected),
  !transparent && selected === 'base-200' && 'border border-base-300', choice && 'relative border border-transparent transition-[border-color] duration-150 hover:border-primary [&_.rich-markdown_a]:relative [&_.rich-markdown_a]:z-20'
]} data-content-card data-box-variant="card" data-surface={transparent ? undefined : selected} data-home-selector-card={choice || undefined}>
  {image && <figure class="shrink-0">
    <img src={image.src} alt={image.alt} width="1200" height="800" loading="lazy" decoding="async"
      class="aspect-3/2 w-full object-cover" style={{ objectPosition: `${image.positionX}% ${image.positionY}%` }} />
  </figure>}
  {detailHref && <a data-card-detail-link href={detailHref} aria-label={href ? `Les om ${title}` : label || title}
    class="absolute inset-0 z-10 rounded-[inherit] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"></a>}
  <div class:list={['card-body min-w-0', heading ? 'gap-0 p-(--panel-pad-lg) max-[1100px]:p-(--panel-pad)' : 'gap-5']}>
    {!iconBesideTitle && <CardDecorations title={heading ? title : undefined} iconName={iconName} badge={badge} badgeClass={badgeClass} badgeCheck={badgeCheck}>
      <slot name="icon" slot="icon" />
    </CardDecorations>}
    {number && <span class="font-semibold" aria-hidden="true" data-card-number>{number}</span>}
    <h3 class:list={['card-title', heading && 'max-w-[390px] text-(length:--type-h3) leading-(--leading-h3) max-[900px]:max-w-[600px]', iconBesideTitle && 'justify-between gap-3']}>
      {iconBesideTitle ? <>
        <span class="min-w-0"><TermText text={title} terms={titleTerms} /></span>
        {iconName ? <PhosphorIcon name={iconName} class="card-icon" /> : <slot name="icon" />}
      </> : <TermText text={heading || title} terms={titleTerms} />}
    </h3>
    {hasRichMarkdown(text) || (heading && /\r?\n[ \t]*\r?\n/.test(text))
      ? <RichMarkdown text={text} variant="card" class={heading ? 'mt-[18px] mb-5' : undefined} />
      : <p class:list={[bodyClass, heading && 'mt-[18px] mb-5 grow-0']}><TermText text={text} terms={textTerms} /></p>}
    {(href || (detailHref && label) || Astro.slots.has('actions')) && <div class:list={['card-actions', choice ? (href ? 'relative z-20 mt-auto' : 'mt-auto') : action === 'link' ? 'mt-auto pt-3' : 'mt-3']}>
      <slot name="actions">
        {href && <a class={actionClasses(action)} href={href} data-card-order-link={choice || undefined}>{label || title}<Arrow diagonal /></a>}
        {!href && detailHref && label && <span class={actionClasses(action)}>{label}<Arrow diagonal /></span>}
      </slot>
    </div>}
  </div>
</article>
