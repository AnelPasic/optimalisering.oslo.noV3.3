---
const { measure = true } = Astro.props;
---
<div data-traffic-preference data-measure={String(measure)}>
  <aside id="traffic-choice" data-traffic-choice hidden aria-labelledby="traffic-choice-title"
    class="fixed inset-x-3 bottom-3 z-40 mx-auto max-w-xl rounded-box border border-base-300 bg-base-100 p-4 text-base-content shadow-lg">
    <h2 id="traffic-choice-title" class="font-semibold" tabindex="-1">Valgfri besøksstatistikk</h2>
    <p class="my-2 text-sm">Med ditt samtykke måler Medon AS hvilke sider som åpnes, aktiv tid, rulling og hvilken kanal eller annonse besøket kom fra. En tilfeldig ID i nettleseren brukes til å telle besøkende. <a class="link" href="/personvern/#besoksstatistikk">Les om målingen</a>.</p>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-outline" data-traffic-answer="no">Avslå statistikk</button>
      <button type="button" class="btn btn-outline" data-traffic-answer="yes">Tillat statistikk</button>
    </div>
  </aside>
  <div class="bg-base-200 px-4 py-2 text-center text-base-content">
    <button type="button" class="btn btn-ghost btn-sm" data-traffic-open aria-controls="traffic-choice" hidden>Innstillinger for besøksstatistikk</button>
  </div>
</div>

<script>
  import { mountTraffic } from '../lib/traffic';
  const preferences = document.querySelector<HTMLElement>('[data-traffic-preference]');
  if (preferences) mountTraffic(preferences);
</script>
