---
import EditorialText from './EditorialText.astro';
import {surfaceAttribute,surfaceClasses} from '../lib/surface';
import '../styles/compositions/hero.css';
import {heroViewSchema,type HeroView} from '../lib/page-hero';
import Arrow from './Arrow.astro';
import TermText from './TermText.astro';
import HeroPhoto from './HeroMedia.astro';
import HeroContainer from './HeroContainer.astro';
import {getCollection} from 'astro:content';
import {getSelectedHeroProof} from '../lib/hero-proof';
import type {getHeroProof} from '../lib/hero-proof';
import {getGlobalElement} from '../lib/home-builder';
interface Props {content:HeroView;proof?:ReturnType<typeof getHeroProof>;demo?:boolean;}
const {content:input,proof,demo=false}=Astro.props;
const content=heroViewSchema.parse(input),family=content.family;
// A Hero selection never bypasses the existing proof-publication/evidence gate.
const proofRecords=content.featuredProofCaseId?(await getCollection('proofCases')).map(entry=>entry.data):[];
const selectedProof=content.featuredProofCaseId
 ? getSelectedHeroProof(content.featuredProofCaseId,getGlobalElement('resultater').content,proofRecords)
 : family==='home'?proof:undefined;
const Heading=demo?'h2':'h1',Section=family==='glossary'?'header':'section';
const inner=['article','assessment','utility'].includes(family),service=family==='service'||family==='index';
const media=content.visual.kind==='image',auxiliary=family==='assessment'&&Astro.slots.has('auxiliary');
const split=content.titleEmphasis==='first-sentence'&&content.title.includes('.')?content.title.indexOf('.')+1:0;
const shellInside=inner;
const surface=surfaceAttribute(content.surface);
const classes=['commercial-hero',surfaceClasses(surface??'default'),family==='home'?'home-hero shell':service?'service-hero shell':family==='pricing'?'pricing-hero shell':inner?'inner-hero':family==='error'?'error-page shell':'glossary-hero'];
const anchor=family==='service'?'service-hero':family==='pricing'?'pricing-hero':undefined;
const centered=content.layout==='centered',left=content.layout==='split-left';
const frameLayout=family==='home'
 ? ['gap-9 min-[1101px]:gap-[88px]',media&&!centered&&(left?'min-[901px]:grid-cols-[1fr_1.15fr]':'min-[901px]:grid-cols-[1.15fr_1fr]')]
 : media
 ? ['gap-8 min-[901px]:gap-16',!centered&&(left?'min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]':'min-[901px]:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]')]
 : auxiliary?['items-start gap-[30px] min-[651px]:gap-[45px] min-[1101px]:gap-[85px]',!centered&&'min-[651px]:grid-cols-2']:[];
---
<Section id={demo?undefined:anchor} class:list={classes} data-surface={surface} data-hero-family={family} data-hero-layout={content.layout} data-hero-visual={media?'image':auxiliary?'auxiliary':'none'}>
 <HeroContainer contained={shellInside}>

  {content.breadcrumbs.length>0&&<nav class="breadcrumbs" aria-label="Brødsmuler"><ul>{content.breadcrumbs.map(crumb=><li>{crumb.href?<a href={crumb.href}>{crumb.label}</a>:<span class="cursor-default" aria-current="page">{crumb.label}</span>}</li>)}</ul></nav>}
  <div class="hero place-items-start">
  <div class:list={['hero-content hero-frame w-full p-0 grid-cols-1',inner&&family!=='assessment'?'max-w-[980px]':'max-w-none',centered?'justify-center':'justify-start',frameLayout,{'grid':media||auxiliary,'inner-hero-grid':inner,'assessment-hero-grid':family==='assessment'}]}>
   <div class:list={['page-hero-copy',{'w-full':!centered,'hero-copy':family==='home','service-hero-copy':service&&media}]}>
    <p class="eyebrow">{family==='home'&&<span class="small-dot"></span>}{content.eyebrow}</p>
    <Heading id={!demo&&family==='pricing'?'pricing-title':undefined} class={family==='home'?'hero-title':undefined}>{split?<><span class="hero-emphasis">{content.title.slice(0,split)}</span>{content.title.slice(split)}</>:content.title.split('\n').map((line,index)=><>{index>0&&<br/>}{line}</>)}</Heading>
    <EditorialText text={content.support} class={['glossary','error'].includes(family)?'hero-support':'hero-intro'}>{family==='home'?<TermText text={content.support} terms={['seo','ai-synlighet','cro']}/>:content.support}</EditorialText>
    {(content.primaryCta||content.secondaryCta)&&<div class={family==='home'||service?'hero-actions':'hero-links'}>{content.primaryCta&&<a class="btn btn-primary" href={content.primaryCta.href}>{content.primaryCta.label}{family==='error'?<>{' '}<span aria-hidden="true">&#8599;</span></>:<Arrow diagonal/>}</a>}{content.secondaryCta&&<a class="text-link" href={content.secondaryCta.href}>{content.secondaryCta.label}<Arrow/></a>}</div>}
    {content.highlights?.length>0&&<ul class="hero-checklist" aria-label="Viktig om tjenesten">{content.highlights.map(point=><li><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3.3 3.3L13 4.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{point}</span></li>)}</ul>}
    <slot name="copy-end"/>
   </div>
   {content.visual.kind==='image'&&auxiliary?<div class="hero-aside"><HeroPhoto content={content.visual.image}/><div class="hero-auxiliary"><slot name="auxiliary"/></div></div>:<>
    {content.visual.kind==='image'&&<HeroPhoto content={content.visual.image} proof={selectedProof}/>}
    {auxiliary&&<div class="hero-auxiliary"><slot name="auxiliary"/></div>}
   </>}
  </div>
  </div>
 </HeroContainer>
</Section>
