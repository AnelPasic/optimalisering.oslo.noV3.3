---
import EditorialText from './EditorialText.astro';
import type {HomepageContent} from '../lib/home-section-data';
type PackageSource=HomepageContent['packages'];
interface Props { packages: PackageSource }
const {packages}=Astro.props;
const labels=packages.comparison;
const format=(price:number)=>new Intl.NumberFormat('nb-NO',{maximumFractionDigits:0}).format(price);
---
<section id="sammenlign" class="package-comparison section-space" aria-labelledby="comparison-heading" data-package-comparison>
  <div class="shell">
    <h2 id="comparison-heading">{labels.heading}</h2>
    <EditorialText class="body-copy package-comparison-intro" text={labels.intro} />
    <div class="package-comparison-scroll overflow-x-auto rounded-box border border-base-content/10 bg-base-100" role="region" aria-label={labels.heading} tabindex="0">
      <table class="table table-zebra table-md package-comparison-table">
        <thead><tr><th scope="col">Sammenlign</th>{packages.items.map(item=><th scope="col">{item.title}</th>)}</tr></thead>
        <tbody>
          <tr><th scope="row">Månedspris eks. mva.</th>{packages.items.map(item=><td>{item.pricePrefix && <span>{item.pricePrefix} </span>}{format(item.price)} {item.priceSuffix}</td>)}</tr>
          <tr><th scope="row">Dette får du</th>{packages.items.map(item=><td>{item.deliverySummary}</td>)}</tr>
          <tr><th scope="row">Passer for</th>{packages.items.map(item=><EditorialText as="td" text={item.compact.fit} />)}</tr>
          <tr><th scope="row">Omfang og prioritering</th>{packages.items.map(item=><EditorialText as="td" text={item.scope?.trim() || item.descriptor} />)}</tr>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Velg pakke</th>
            {packages.items.map(item=><td><a class="btn btn-outline" href={`#package-order-${item.key}`} data-open-package-order={item.key}>Velg {item.title}</a></td>)}
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</section>
<script>
 const root=document.querySelector<HTMLElement>('[data-package-comparison]');
 if(root){
   root.addEventListener('click',event=>{
     const link=(event.target instanceof Element?event.target.closest<HTMLAnchorElement>('[data-open-package-order]'):null);
     if(!link)return;
     const key=link.dataset.openPackageOrder;
     const target=[...document.querySelectorAll<HTMLDetailsElement>('[data-package-order]')].find(x=>x.dataset.packageKey===key);
     if(!target)return;
     event.preventDefault();
     target.open=true;
     target.querySelector('summary')?.focus({preventScroll:true});
     target.scrollIntoView({behavior:'smooth',block:'center'});
   });
 }
</script>
