---
import type { CollectionEntry } from 'astro:content';
import HeroCopy from './ServiceHeroCopy.astro';
import HeroVisual from './ServiceHeroVisual.astro';
import { resolveServiceVisual } from '../lib/service-visual';
import ContentSection from './HomeSection.astro';
import PricingBridge from './ServicePricingBridge.astro';
interface Props {
  page: CollectionEntry<'pages'>['data'];
  commercial: NonNullable<CollectionEntry<'pages'>['data']['homepage']>;
}
const { page, commercial } = Astro.props;
const pricingLink = page.sections.find(section => section.id === 'sammenheng')!.links!.find(link => link.href === '/priser/')!;
const breadcrumb = commercial.chrome.navigation.find(link => link.href === `/${page.slug}/`)?.label ?? page.eyebrow;
const serviceName = page.slug.charAt(0).toLocaleUpperCase('nb-NO') + page.slug.slice(1);
const sectionVisuals: Record<string, 'behov' | 'kanaler'> = { friksjon: 'behov', kvalitet: 'kanaler' };
const visual = resolveServiceVisual(page.heroVisual);
---
<div class="invite-home invite-service">
  <section id="service-hero" class="service-hero shell">
    <nav class="breadcrumbs" aria-label="Brødsmuler"><a href="/">Forsiden</a><span aria-hidden="true">/</span><span>{breadcrumb}</span></nav>
    {visual ? <div class="service-hero-split"><div class="service-hero-copy"><HeroCopy page={page} pricingLink={pricingLink} /></div><HeroVisual visual={visual} /></div> : <HeroCopy page={page} pricingLink={pricingLink} />}
  </section>
  {page.sections.map(section => <>
    <ContentSection section={section} visualId={sectionVisuals[section.id]} />
    {section.id === 'sammenheng' && <PricingBridge content={commercial.packages} link={pricingLink} serviceName={serviceName} />}
  </>)}
  <section id="sporsmal" class="faq-section section-space"><div class="shell faq-grid"><div><p class="eyebrow">{commercial.faqEyebrow}</p><h2>{commercial.faqHeading}</h2></div><div class="faq-list">{page.faq.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>
</div>
