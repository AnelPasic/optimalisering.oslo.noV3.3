---
import type { HomepageContent } from '../lib/home-section-data';
import { site } from '../config/site';
import { glossary } from '../lib/terminology';
interface Props { content: HomepageContent['chrome']; }
const { content } = Astro.props;
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><a class="footer-brand" href="/">{content.brand} {content.brandLocation}<span>.</span></a><p>{content.providerText}</p>{site.preview && <span class="preview-tag">{content.previewLabel}</span>}</div>
    <nav aria-label={content.serviceNavigationLabel}>{content.navigation.map(link => <a href={link.href}>{link.label}</a>)}<a href={content.storeLink.href}>{content.storeLink.label}</a></nav>
    <nav aria-label={content.informationNavigationLabel}>{content.informationLinks.map(link => <a href={link.href}>{link.label}</a>)}<a href="/begreper/">{glossary.linkLabel}</a></nav>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {content.copyrightProvider}</span><span>{content.footerNote}</span></div>
</footer>
