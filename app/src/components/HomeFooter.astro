---
import type { HomepageContent } from '../lib/home-section-data';
import { glossary } from '../lib/terminology';
interface Props { content: HomepageContent['chrome']; }
const { content } = Astro.props;
// Earlier CMS snapshots remain renderable until the new footer groups are
// populated. New layouts own their link order separately from the mega menu.
const footerGroups = content.footerGroups ?? [
  { heading: content.serviceNavigationLabel,
    links: [...content.navigation.map(({ label, href }) => ({label,href})), content.storeLink] },
  { heading: content.informationNavigationLabel, links: content.informationLinks },
  { heading: 'Veiledning', links: [{ label: glossary.linkLabel, href: '/begreper/' }] },
];
const legalLinks = content.footerLegalLinks ?? [];
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer footer-grid footer-grid--columns footer-vertical min-[651px]:footer-horizontal gap-x-5 gap-y-8 pb-9 min-[651px]:pb-[55px] text-(length:--type-body) leading-(--leading-body) *:w-full">
      <div class="footer-about block justify-items-normal">
        <a class="footer-title footer-brand normal-case opacity-100 mb-0" href="/">{content.brand} {content.brandLocation}<span>.</span></a>
        <p>{content.providerText}</p>
      </div>
      {footerGroups.map(group => (
        <nav class="footer-link-group" aria-label={group.heading}>
          <h2 class="footer-title footer-group-title">{group.headingHref
            ? <a href={group.headingHref}>{group.heading}</a>
            : group.heading}</h2>
          {group.links.map(link => <a href={link.href}>{link.label}</a>)}
        </nav>
      ))}
    </div>
  </div>
  <div class="shell footer-bottom footer-bottom--columns">
    <span>© {new Date().getFullYear()} {content.copyrightProvider}</span>
    <span>{content.footerNote}</span>
    {legalLinks.length > 0 && <nav aria-label="Personvern og informasjon">
      {legalLinks.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>}
  </div>
</footer>
