---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props {
  content: NonNullable<CollectionEntry<'pages'>['data']['homepage']>['packages'];
  link: { label: string; href: string };
}
const { content, link } = Astro.props;
const contexts = ['Når Synlighet er det ene prioriterte området.', 'Når Synlighet jobber sammen med et annet område.'];
const formatPrice = (value: number) => new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 0 }).format(value);
---
<section id="service-priser" class="service-pricing section-space">
  <div class="shell">
    <div class="service-pricing-heading"><div><p class="eyebrow">{content.eyebrow}</p><h2>{content.heading}</h2></div><a class="text-link" href={link.href}>{link.label}<Arrow /></a></div>
    <div class="service-package-grid">{content.items.slice(0, 2).map((item, index) => <article class:list={['service-package', { 'is-recommended': item.recommended }]}>
      <div class="package-heading"><h3>{item.title}</h3>{item.recommended && item.badge && <span class="package-badge">{item.badge}</span>}</div>
      <p>{contexts[index]}</p>
      <div class="package-price"><p><span class="package-price-amount">{formatPrice(item.price)}</span> <span class="package-price-unit">{item.priceSuffix}</span></p><p class="small-copy">{item.vatSuffix}</p></div>
    </article>)}</div>
  </div>
</section>
