---
import type { HomepageContent } from '../lib/home-section-data';
import type { CollectionEntry } from 'astro:content';
import CommercialHero from './CommercialHero.astro';
import {resolvePageHero} from '../lib/page-hero';
import Faq from './Faq.astro';
import '../styles/compositions/pricing.css';
import PricingDecision from './PricingDecision.astro';
import PricingMultiplier from './PricingMultiplier.astro';
import Comparison from './PackageComparison.astro';
import ContentSection from './HomeSection.astro';
import GlobalContentSection from './GlobalContentSection.astro';
import PageList from './PageList.astro';
import ProofList from './ProofList.astro';
import { visibleServiceSections } from '../lib/service-sections';
interface Props {
  page: CollectionEntry<'pages'>['data'];
  commercial: HomepageContent;
}
const { page, commercial } = Astro.props;
const packages = commercial.packages;
const hasGlobalFaq = page.sections.some(section => section.globalElement === 'sporsmal');
// D-024's pricing context adds "også" to the shared external-cost rule.
// Keep that locked connector while rendering the rules from one CMS source.
const sections = page.sections.map(section => section.id === 'kostnader' ? {
  ...section, body: [`${packages.adBudgetNote} ${packages.externalCostsNote.replace('kommer i tillegg', 'kommer også i tillegg')}`, packages.separateWorkNote, packages.capacityNote],
} : section);
---
<div class="invite-home invite-pricing">
  <CommercialHero content={resolvePageHero(page,commercial)} />
  {/* All pricing placements are now authored in the CMS sections list. */}
  {visibleServiceSections({slug:page.slug,sections}).map(section => section._block==='pricingModule'
    ? section.pricingModule==='valg'
      ? <PricingDecision packages={packages} />
      : section.pricingModule==='vekst'
        ? <PricingMultiplier packages={packages} />
        : <Comparison packages={packages} />
    : section.globalElement
      ? <GlobalContentSection element={section.globalElement} pricingExpanded={section.globalElement==='priser'} faqItems={page.faq} />
    : section._block==='proofList'&&section.proofList ? <ProofList sectionId={section.id} config={section.proofList} /> : section._block==='pageList' ? <PageList section={section} /> : <ContentSection section={section} linkVariant={section.id==='gratis'?'button':undefined} infoSurface={section.id==='gratis'}>
    {section.id === 'arbeidsomrader' && <div class="package-notes body-copy"><p>{packages.areasLabel}: {packages.areas.join(' / ')}.</p><p>{packages.foundationNote}</p></div>}
  </ContentSection>)}
  {!hasGlobalFaq && <Faq items={page.faq} id="sporsmal" heading={commercial.faqVisible===false?undefined:commercial.faqHeading} eyebrow={commercial.faqVisible===false?undefined:commercial.faqEyebrow} />}
</div>
