---
import ContentCard from './ContentCard.astro';
import type { CollectionEntry } from 'astro:content';
import type { HomepageBlock } from '../lib/home-builder';
import { assertNever } from '../lib/home-builder';
import type { Surface } from '../lib/surface';
import HomeSymbol from './HomeSymbol.astro';
import Leverage from './HomeLeverage.astro';
import ContentSection from './HomeSection.astro';
import Assessment from './HomeAssessment.astro';
import Proof from './HomeProof.astro';
import Packages from './PackageSection.astro';
import Faq from './Faq.astro';
import PageList from './PageList.astro';
import ProofList from './ProofList.astro';
import { combineFaqItems, type FaqItem } from '../lib/faq-items';
interface Props { block: HomepageBlock; index?: number; records: CollectionEntry<'proofCases'>['data'][]; faqItems?: readonly FaqItem[]; }
const {block,index,records,faqItems=[]}=Astro.props;
const render=(value:HomepageBlock)=>{switch(value._block){case 'selector':case 'calculator':case 'packages':case 'proof':case 'content':case 'assessment':case 'faq':case 'pageList':case 'proofList':return value._block;default:return assertNever(value);}};
render(block);
const selectorSurfaces: Surface[] = ['info', 'base-300', 'secondary'];
---
{block._block === 'selector' && <section id={block.id} class="need-section section-space">
  <div class="shell">
    <h2>{block.content.heading}</h2>
    <div class="mt-[44px] grid grid-cols-3 gap-(--gap-lg) max-[900px]:grid-cols-1 max-[650px]:mt-8 max-[650px]:gap-(--gap)">
      {block.content.items.map((item, index) => <ContentCard
        title={item.discipline}
        headline={item.title}
        text={item.description}
        surface={selectorSurfaces[index]}
        iconName={item.iconName}
        badge={item.badge}
        badgeClass={item.badgeClass}
        detailHref={item.link.href}
        label={item.link.label}
        linkVariant="text"
        choice
      >
        <HomeSymbol slot="icon" kind={index === 0 ? 'search' : index === 1 ? 'choose' : 'both'} />
      </ContentCard>)}
    </div>
  </div>
</section>}
{block._block==='calculator'&&<Leverage content={block.content} />}
{block._block==='packages'&&<Packages content={block.content} />}
{block._block==='proof'&&<Proof content={block.content} records={records} />}
{block._block==='content'&&<ContentSection section={block} index={index} />}
{block._block==='pageList'&&<PageList section={{...block,layout:'default'}} index={index} />}
{block._block==='proofList'&&<ProofList sectionId={block.id} config={block.proofList} records={records} />}
{block._block==='assessment'&&<Assessment section={block.content.section} content={block.content.form} layout={block.content.layout} />}
{block._block==='faq'&&<Faq id={block.id} {...block.content} items={combineFaqItems(block.content.items, faqItems)} />}
