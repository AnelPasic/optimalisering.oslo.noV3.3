---
import type { CollectionEntry } from 'astro:content';
import type { HomepageBlock } from '../lib/home-builder';
import { assertNever } from '../lib/home-builder';
import Arrow from './Arrow.astro';
import HomeSymbol from './HomeSymbol.astro';
import Leverage from './HomeLeverage.astro';
import ContentSection from './HomeSection.astro';
import Assessment from './HomeAssessment.astro';
import Proof from './HomeProof.astro';
import Packages from './PackageSection.astro';
import Faq from './Faq.astro';
import PageList from './PageList.astro';
import { combineFaqItems, type FaqItem } from '../lib/faq-items';
interface Props { block: HomepageBlock; records: CollectionEntry<'proofCases'>['data'][]; faqItems?: readonly FaqItem[]; }
const {block,records,faqItems=[]}=Astro.props;
const render=(value:HomepageBlock)=>{switch(value._block){case 'selector':case 'calculator':case 'packages':case 'proof':case 'content':case 'assessment':case 'faq':case 'pageList':return value._block;default:return assertNever(value);}};
render(block);
---
{block._block==='selector'&&<section id={block.id} class="need-section section-space"><div class="shell"><h2>{block.content.heading}</h2><div class="mt-[44px] grid grid-cols-3 gap-(--gap-lg) max-[900px]:grid-cols-1 max-[650px]:mt-8 max-[650px]:gap-(--gap)">{block.content.items.map((item,index)=><a data-home-selector-card class:list={['card min-w-0 border border-transparent no-underline transition-[border-color] duration-150 hover:border-primary',index===0?'bg-info':index===1?'bg-base-300':'bg-secondary text-info']} href={item.link.href}><div class="card-body min-w-0 gap-0 p-(--panel-pad-lg) max-[1100px]:p-(--panel-pad)"><div class="mb-[26px] flex items-center justify-between gap-(--gap-sm) max-[900px]:mb-[18px]"><span class="text-(length:--type-body) font-semibold leading-(--leading-body)">{item.discipline}</span><HomeSymbol kind={index===0?'search':index===1?'choose':'both'} /></div><h3 class="max-w-[390px] max-[900px]:max-w-[600px]">{item.title}</h3><p class:list={['mt-[18px] mb-5 grow-0 break-words text-(length:--type-body) leading-(--leading-body)',index===2?'text-inherit':'text-(--muted)']}>{item.description}</p><div class="card-actions mt-auto"><span class="text-link">{item.link.label}<Arrow diagonal /></span></div></div></a>)}</div></div></section>}
{block._block==='calculator'&&<Leverage content={block.content} />}
{block._block==='packages'&&<Packages content={block.content} />}
{block._block==='proof'&&<Proof content={block.content} records={records} />}
{block._block==='content'&&<ContentSection section={block} />}
{block._block==='pageList'&&<PageList section={{...block,layout:'default'}} />}
{block._block==='assessment'&&<Assessment section={block.content.section} content={block.content.form} layout={block.content.layout} />}
{block._block==='faq'&&<Faq id={block.id} {...block.content} items={combineFaqItems(block.content.items, faqItems)} />}
