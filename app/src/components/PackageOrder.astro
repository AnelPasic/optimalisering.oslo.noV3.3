---
import EditorialText from './EditorialText.astro';
import type { HomepageContent } from '../lib/home-section-data';
import Arrow from './Arrow.astro';
import { site } from '../config/site';
type Package = HomepageContent['packages']['items'][number];
interface Props { item: Package; featured?: boolean; orderIntro: string; orderSubmitLabel: string; }
const { item, featured = false, orderIntro, orderSubmitLabel } = Astro.props;
const id = (field: string) => `package-${item.key}-${field}`;
const formatPrice = (value: number) => new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 0 }).format(value);
const enabled = site.ordersEnabled;
// Real intake requires backend, privacy, notification and launch approval.
---
<details id={`package-order-${item.key}`} class="package-order-inline" data-package-order data-package-key={item.key}>
  <summary class:list={['btn', featured ? 'btn-secondary' : 'btn-primary']}>{item.cta.label}<Arrow diagonal /></summary>
  <div class="package-order-panel">
    <h4>Bestill {item.title}</h4>
    <p class="package-order-selection"><strong>Valgt pakke:</strong> {item.title} - {item.pricePrefix && `${item.pricePrefix} `}{formatPrice(item.price)} {item.priceSuffix} {item.vatSuffix}</p>
    <EditorialText text={orderIntro} />
    <form data-package-order-form data-enabled={String(enabled)} data-endpoint={site.leadEndpoint} method="post" onsubmit="return false">
      <input type="hidden" name="form" value="pakke-bestilling" />
      <input type="hidden" name="package" value={item.key} />
      <div class="package-order-fields">
        <label for={id('website')}>Nettside <span aria-hidden="true">*</span></label>
        <input class="input w-full" id={id('website')} name="website" type="text" inputmode="url" autocomplete="url" placeholder="dinbedrift.no" maxlength="2048" required />
        <label for={id('email')}>Jobb-e-post <span aria-hidden="true">*</span></label>
        <input class="input w-full" id={id('email')} name="email" type="email" autocomplete="email" placeholder="deg@dinbedrift.no" maxlength="254" required />
        <label for={id('phone')}>Telefon <span class="optional">(valgfritt)</span></label>
        <input class="input w-full" id={id('phone')} name="phone" type="tel" autocomplete="tel" maxlength="40" />
      </div>
      <div hidden aria-hidden="true"><label for={id('website-confirmation')}>La feltet stå tomt</label><input id={id('website-confirmation')} name="website_confirmation" tabindex="-1" autocomplete="off" maxlength="200" /></div>
      <p class="form-privacy">Ikke send innlogging eller sensitive opplysninger. <a href="/personvern/">Les om personvern</a>.</p>
      {!enabled && <p class="form-notice alert alert-warning">Dette er en forhåndsvisning. Bestilling er ikke åpnet ennå. Ingen opplysninger blir sendt.</p>}
      <button type="submit" class="btn btn-primary package-order-submit" disabled>{orderSubmitLabel}<Arrow diagonal /></button>
      <p class="form-status" data-order-status role="status" aria-live="polite" tabindex="-1" hidden></p>
      <noscript><p>Skjemaet trenger JavaScript. <a href="/kontakt/">Se kontaktinformasjon</a>.</p></noscript>
    </form>
  </div>
</details>
<script>
  import { createOrderPayload } from '../lib/order';
  import { submitLead } from '../lib/lead';
  import { captureAttribution } from '../lib/attribution';
  const accordions = [...document.querySelectorAll<HTMLDetailsElement>('[data-package-order]')];
  for (const details of accordions) {
    details.addEventListener('toggle', () => {
      if (!details.open) return;
      for (const other of accordions) if (other !== details) other.open = false;
    });
    const form = details.querySelector<HTMLFormElement>('[data-package-order-form]')!;
    const button = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-order-status]')!;
    const enabled = form.dataset.enabled === 'true';
    const endpoint = form.dataset.endpoint ?? '';
    let key = crypto.randomUUID(), previousBody = '', busy = false;
    const show = (message: string) => { status.textContent = message; status.hidden = false; status.focus({preventScroll: true}); };
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!enabled) { show('Bestilling er ikke åpnet ennå. Ingen opplysninger blir sendt.'); return; }
      if (busy) return;
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const fields = Object.fromEntries(new FormData(form).entries()) as Record<string,string>;
      if (fields.website_confirmation) return;
      let payload;
      try {
        payload = createOrderPayload(fields, {page: location.pathname, ...captureAttribution(location.href,document.referrer)});
      } catch(error) { show(error instanceof Error ? error.message : 'Kontroller feltene og prøv igjen.'); return; }
      const body = JSON.stringify(payload);
      if (previousBody && previousBody !== body) key = crypto.randomUUID();
      previousBody = body;
      busy = true; button.disabled = true; button.setAttribute('aria-busy','true');
      show('Sender bestillingen.');
      try {
        await submitLead(endpoint,payload,{idempotencyKey:key});
        show('Bestillingen er mottatt. Vi tar kontakt for å avklare videre oppstart.');
        form.reset(); key = crypto.randomUUID(); previousBody = '';
        window.location.assign('/takk/');
      } catch(error) { show(error instanceof Error ? error.message : 'Vi kunne ikke bekrefte bestillingen. Prøv igjen.'); }
      finally { busy = false; button.disabled = !enabled; button.removeAttribute('aria-busy'); }
    });
    // The review gate also applies to native/programmatic submission.
    form.submit = () => form.requestSubmit();
    button.disabled = !enabled;
  }
  // Legacy deep links from packages to /priser/?pakke=…#bestill.
  if (location.pathname === '/priser/') {
    const openSelected = () => {
      const key = new URL(location.href).searchParams.get('pakke');
      if (!key) return;
      const match = accordions.find(a => a.dataset.packageKey === key);
      if (!match) return;
      match.open = true;
      match.scrollIntoView({block:'center'});
    };
    openSelected();
    window.addEventListener('popstate', openSelected);
  }
</script>
