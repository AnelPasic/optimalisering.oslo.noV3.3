---
import type { HomepageContent } from '../lib/home-section-data';
import { getPublishableCases } from '../lib/proof';
import { resolveFeaturedProofVisual } from '../lib/proof-presentation';
import TermText from './TermText.astro';
interface Props {
  content: HomepageContent['proof'];
  records: unknown[];
  primary?: boolean;
}
const { content, records, primary = false } = Astro.props;
const cases = getPublishableCases(content, records);
const visual = primary ? undefined : resolveFeaturedProofVisual(content.featuredVisual, content, records);
---
{cases.length > 0 && <section id="resultater" class="proof-section section-space"><div class="shell">
  <div class:list={['section-heading', {'mb-(--gap-lg)': !primary}]}><p class="eyebrow">{content.eyebrow}</p><h2><TermText text={content.heading} terms={['roas', 'checkout', 'organisk-trafikk']} /></h2></div>
  <div class:list={primary ? ['proof-grid', 'proof-primary'] : ['proof-home', 'grid gap-6 md:grid-cols-2']}>{cases.map((proof, index) => <article class:list={primary ? ['proof-card', {'proof-featured': index === 0}] : ['card bg-base-100', {'md:card-side md:col-span-2 proof-featured': index === 0}]}>
    {primary ? <>
    <div class="proof-context">
      {!primary && index === 0 && visual && <div class="proof-media"><img src={visual.src} alt={visual.alt} width="1011" height="674" loading="lazy" decoding="async" style={{ objectPosition: `${visual.positionX}% ${visual.positionY}%` }} /></div>}
      <div class="proof-identity"><h3>{proof.displayName}</h3>
        {(primary || index > 0) && <><p class="proof-metric"><TermText text={proof.dominantMetric} terms={['roas', 'google-ads', 'checkout', 'organisk-trafikk', 'google-search-console']} /></p>{proof.delta && <p class="proof-delta">{proof.delta}</p>}</>}
      </div>
    </div>
    <div class:list={['proof-result-area', { 'proof-result-featured': !primary && index === 0 }]}>
      <div class="proof-result-main">
        {!primary && index === 0 && <p class="proof-metric"><TermText text={proof.dominantMetric} terms={['roas', 'google-ads']} /></p>}
        <div class="proof-comparison"><dl><dt>{content.beforeLabel}</dt><dd><strong>{proof.before}</strong><span>{proof.period.before}</span></dd></dl><span class="proof-arrow" aria-hidden="true">-&gt;</span><dl><dt>{content.afterLabel}</dt><dd><strong>{proof.after}</strong><span>{proof.period.after}</span></dd></dl></div>
      </div>
      {!primary && index === 0 && proof.delta && <p class="proof-delta proof-result-support">{proof.delta}</p>}
    </div>
    </> : <>
      {index === 0 && visual && <figure class="md:w-1/2"><img src={visual.src} alt={visual.alt} width="1440" height="1000" loading="lazy" decoding="async" style={{ objectPosition: `${visual.positionX}% ${visual.positionY}%` }} /></figure>}
      <div class="card-body min-w-0 gap-5">
        <h3 class="card-title">{proof.displayName}</h3>
        <p class="card-copy grow-0"><TermText text={proof.dominantMetric} terms={['roas', 'google-ads', 'checkout', 'organisk-trafikk', 'google-search-console']} /></p>
        <div class="proof-values grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-start gap-4"><dl><dt>{content.beforeLabel}</dt><dd><strong>{proof.before}</strong><span>{proof.period.before}</span></dd></dl><span class="self-center" aria-hidden="true">-&gt;</span><dl><dt>{content.afterLabel}</dt><dd><strong>{proof.after}</strong><span>{proof.period.after}</span></dd></dl></div>
        {proof.delta && <p class="card-copy grow-0">{proof.delta}</p>}
      </div>
    </>}

  </article>)}</div>
</div></section>}

<style>
  .proof-section { background: #f7f6ef; }
  .proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .proof-card { min-width: 0; padding: var(--panel-pad-feature); border-radius: var(--radius-card-lg); background: var(--surface-mint); color: #173d39; }
  .proof-primary .proof-featured { grid-column: 1 / -1; background: var(--surface-dark); color: #fff9ec; }
  .proof-primary { grid-template-columns: minmax(0, 1fr); }
  .proof-primary h3 { margin: 0 0 12px; font-size: var(--type-h3); line-height: var(--leading-h3); }
  .proof-metric { margin: 0; font-weight: var(--weight-heading); }
  .proof-delta { margin: 8px 0 0; font-family: 'Instrument Sans Variable', sans-serif; font-size: var(--type-h3); font-weight: var(--weight-heading); line-height: var(--leading-h3); }
  .proof-comparison { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: var(--gap-md); margin: 24px 0 0; max-width: 800px; }
  .proof-comparison dl { margin: 0; }
  .proof-primary dt { font-size: var(--type-label); font-weight: var(--weight-label); line-height: var(--leading-small); }
  .proof-primary dd { margin: 0; }
  .proof-comparison strong { display: block; font-family: 'Instrument Sans Variable', sans-serif; font-size: var(--type-stat); line-height: var(--leading-stat); font-weight: var(--weight-heading); overflow-wrap: anywhere; }
  .proof-featured .proof-comparison strong { font-size: var(--type-display); line-height: var(--leading-stat); }
  .proof-comparison dd span { display: block; margin-top: 8px; font-size: var(--type-meta); line-height: var(--leading-small); }
  .proof-arrow { font-size: var(--type-icon); align-self: center; line-height: var(--leading-small); }
  .proof-primary .proof-context { display: contents; }
  .proof-identity, .proof-result-area, .proof-result-main { display: contents; }
  /* Only numerical and period roles are specific to proof; Cards use the theme. */
  .proof-values dl, .proof-values dd { margin: 0; }
  .proof-values dt { font-size: var(--type-label); font-weight: var(--weight-label); line-height: var(--leading-small); }
  .proof-values strong { display: block; font-family: 'Instrument Sans Variable', sans-serif; font-size: var(--type-h3); font-weight: var(--weight-heading); line-height: var(--leading-stat); white-space: nowrap; }
  .proof-featured .proof-values strong { font-size: var(--type-stat); }
  .proof-values dd span { display: block; margin-top: var(--gap-xs); font-size: var(--type-meta); line-height: var(--leading-small); }
  @media (max-width: 700px) {
    .proof-grid { grid-template-columns: minmax(0, 1fr); }
    .proof-comparison { gap: var(--gap-xs); }
  }
</style>
