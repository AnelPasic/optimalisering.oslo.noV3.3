---
import type { CollectionEntry } from 'astro:content';
import { getPublishableCases } from '../lib/proof';
interface Props {
  content: NonNullable<CollectionEntry<'pages'>['data']['homepage']>['proof'];
  records: unknown[];
  primary?: boolean;
}
const { content, records, primary = false } = Astro.props;
const cases = getPublishableCases(content, records);
---
{cases.length > 0 && <section id="resultater" class="proof-section section-space"><div class="shell">
  <div class="section-heading"><p class="eyebrow">{content.eyebrow}</p><h2>{content.heading}</h2></div>
  <div class:list={['proof-grid', { 'proof-primary': primary }]}>{cases.map((proof, index) => <article class:list={['proof-card', { 'proof-featured': index === 0 }]}>
    <h3>{proof.displayName}</h3><p class="proof-metric">{proof.dominantMetric}</p>
    {proof.delta && <p class="proof-delta">{proof.delta}</p>}
    <div class="proof-comparison"><dl><dt>{content.beforeLabel}</dt><dd><strong>{proof.before}</strong><span>{proof.period.before}</span></dd></dl><span class="proof-arrow" aria-hidden="true">-&gt;</span><dl><dt>{content.afterLabel}</dt><dd><strong>{proof.after}</strong><span>{proof.period.after}</span></dd></dl></div>
    <dl class="proof-work"><dt>{content.changeLabel}</dt><dd>{proof.intervention}</dd></dl>
    <p class="proof-caveat">{proof.limitations}</p>
  </article>)}</div>
</div></section>}

<style>
  .proof-section { background: #f7f6ef; }
  .proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .proof-card { min-width: 0; padding: clamp(24px, 3vw, 44px); border-radius: 24px; background: #e0f0ef; color: #173d39; }
  .proof-featured { grid-column: 1 / -1; background: #320c43; color: #fff9ec; }
  .proof-primary { grid-template-columns: minmax(0, 1fr); }
  h3 { margin: 0 0 12px; font-size: clamp(26px, 3vw, 38px); }
  .proof-metric { margin: 0; font-weight: 600; }
  .proof-delta { margin: 8px 0 0; font-family: 'Instrument Sans Variable', sans-serif; font-size: 26px; font-weight: 600; }
  .proof-comparison { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: 16px; margin: 28px 0; max-width: 800px; }
  .proof-comparison dl { margin: 0; }
  dt { font-size: 14px; font-weight: 600; }
  dd { margin: 0; }
  .proof-comparison strong { display: block; font-family: 'Instrument Sans Variable', sans-serif; font-size: clamp(32px, 4vw, 56px); line-height: 1.2; font-weight: 600; white-space: nowrap; }
  .proof-featured .proof-comparison strong { font-size: clamp(40px, 6vw, 80px); }
  .proof-comparison dd span { display: block; margin-top: 8px; font-size: 14px; }
  .proof-arrow { font-size: 24px; align-self: center; }
  .proof-work { margin: 0 0 16px; max-width: 75ch; }
  .proof-work dd { margin-top: 4px; }
  .proof-caveat { margin: 0; max-width: 85ch; font-size: 15px; line-height: 1.6; }
  @media (max-width: 700px) {
    .proof-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .proof-comparison { gap: 8px; }
    .proof-comparison strong { font-size: clamp(30px, 8vw, 48px); }
    .proof-featured .proof-comparison strong { font-size: clamp(34px, 10vw, 56px); }
    .proof-arrow { font-size: 20px; }
  }
</style>
