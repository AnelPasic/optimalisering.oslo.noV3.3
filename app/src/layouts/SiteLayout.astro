---
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Attribution from '../components/Attribution.astro';
import { site } from '../config/site';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Medon AS', url: 'https://medon.no' };
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ec" />
    <link rel="canonical" href={canonical} />
    {(site.preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a href="#main" class="skip-link">Hopp til innhold</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <Attribution />
  </body>
</html>
