---
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/figtree';
import '../styles/app.css';
import TerminologyUI from '../components/TerminologyUI.astro';
import { getCollection } from 'astro:content';
import {validateHomepagePublicLinks} from '../lib/home-builder';
import HomeHeader from '../components/HomeHeader.astro';
import HomeFooter from '../components/HomeFooter.astro';
import SiteSearch from '../components/SiteSearch.astro';
import SiteChromeThemeHead from '../components/SiteChromeThemeHead.astro';
import Attribution from '../components/Attribution.astro';
import { site } from '../config/site';
import { defaultLocale, type Locale } from '../config/locales';
import type { LanguageLink } from '../lib/i18n';
interface Props { title:string;description:string;noindex?:boolean;locale?:Locale;languageLinks?:LanguageLink[]; }
const {title,description,noindex=false,locale=defaultLocale,languageLinks=[]}=Astro.props;
const pages=(await getCollection('pages')).map(p=>p.data);
const homepageSource=pages.find(p=>p.kind==='home');
if(homepageSource)validateHomepagePublicLinks(homepageSource,pages);
const home=homepageSource?.homepage;
if(!home)throw new Error('Shared commercial chrome requires the homepage source');
const homeChrome=home.chrome;
const canonical = new URL(Astro.url.pathname, site.url).href;
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: site.provider, url: site.providerUrl };
---
<!doctype html>
<html lang={locale} data-theme="optimalisering">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ec" />
    <link rel="canonical" href={canonical} />
    {(site.preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'nb' ? 'nb_NO' : 'en_GB'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SiteChromeThemeHead themes={homeChrome.themes} enabled={homeChrome.headerOptions.showThemeSwitch} />
    {homeChrome.headerOptions.showSearch && <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />}
    {homeChrome.headerOptions.showSearch && <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>}
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
  </head>
  <body data-ui-shell="true" class="site-shell">
    <a href="#main" class="skip-link">{homeChrome.skipLabel}</a>
    <HomeHeader content={homeChrome} languageLinks={languageLinks} currentLocale={locale} />
    <main id="main" data-pagefind-body={noindex || Astro.url.pathname.startsWith("/design-system/") ? undefined : ""}><slot /></main>
    <HomeFooter content={homeChrome} />
    {homeChrome.headerOptions.showSearch && <SiteSearch mode="modal" />}
    <Attribution />
    <TerminologyUI />
  </body>
</html>
