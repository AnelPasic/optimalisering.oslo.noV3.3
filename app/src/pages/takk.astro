---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Takk for henvendelsen | Optimalisering Oslo"
  description="Vi har mottatt henvendelsen din og følger opp på e-post."
  noindex
>
  <section class="shell section-space text-center" aria-labelledby="receipt-heading">
    <div class="mx-auto max-w-xl">
      <h1 id="receipt-heading">Takk! Henvendelsen er mottatt.</h1>
      <p class="body-copy mt-4">Vi følger opp på e-post.</p>
      <a class="btn btn-primary mt-6" href="/">Til forsiden</a>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  // Count only the receipt for a lead accepted by the intake endpoint.
  (function () {
    var key = "optimalisering:confirmed-lead-for-takk";
    function pending() {
      try { return window.sessionStorage.getItem(key) === "1"; } catch (_) { return false; }
    }
    function clear() {
      try { window.sessionStorage.removeItem(key); } catch (_) {}
    }
    if (!pending()) return;

    function recordConfirmedLead() {
      if (!pending()) return;
      var api = window.OptimaliseringOpenAIAds;
      var choice = api && api.getChoice();
      if (choice === "no") {
        clear();
        window.removeEventListener("optimalisering:ads-consent-changed", recordConfirmedLead);
        return;
      }
      if (choice !== "yes" || typeof window.oaiq !== "function") return;
      clear(); // Before measurement, so refresh/back cannot double count.
      window.removeEventListener("optimalisering:ads-consent-changed", recordConfirmedLead);
      window.oaiq("measure", "lead_created", { type: "customer_action" });
    }
    window.addEventListener("optimalisering:ads-consent-changed", recordConfirmedLead);
    recordConfirmedLead();
  })();
</script>
