---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Takk for henvendelsen | Optimalisering Oslo"
  description="Vi har mottatt henvendelsen din og følger opp på e-post."
  noindex
>
  <section class="shell section-space text-center" aria-labelledby="receipt-heading">
    <div class="mx-auto max-w-xl">
      <h1 id="receipt-heading">Takk! Henvendelsen er mottatt.</h1>
      <p class="body-copy mt-4">Vi følger opp på e-post.</p>
      <a class="btn btn-primary mt-6" href="/">Til forsiden</a>
    </div>
  </section>
</SiteLayout>
