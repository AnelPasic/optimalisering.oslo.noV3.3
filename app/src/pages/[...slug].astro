---
import type { HomepageContent } from '../lib/home-section-data';
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomePage from '../components/HomePage.astro';
import InnerPage from '../components/InnerPage.astro';
import PricingPage from '../components/PricingPage.astro';
import ServicePage from '../components/ServiceFamilyPage.astro';
import { resolveRouteFamily } from '../lib/route-family';
import InsightIndexPage from '../components/InsightIndexPage.astro';
import { resolveHomepageContent } from '../lib/home-builder';
import { createCommercialTextBinding } from '../lib/commercial-text';
import { defaultLocale } from '../config/locales';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  if (pages.some(entry => (entry.data.locale ?? defaultLocale) !== defaultLocale)) throw new Error('English route publication requires a separate approved rollout');
  const home = pages.find(page => page.data.kind === 'home')?.data;
  const pricing = pages.find(page => page.data.kind === 'pricing')?.data;
  if (!home || !pricing) throw new Error('Homepage commercial source and approved pricing support are required');
  const commercial = resolveHomepageContent(home);
  const bind = createCommercialTextBinding(home, pricing);
  return pages.map(entry => {
    const data = entry.data;
    const route = resolveRouteFamily(data);
    const page = route.bindCommercialText ? {
      ...data, seo: { title: bind(data.seo.title), description: bind(data.seo.description) },
      faq: data.faq.map(item => ({ ...item, answer: bind(item.answer) })),
      sections: route.family==='home'?data.sections.map(section=>section._block==='faq'?{...section,content:{eyebrow:commercial.faqEyebrow,heading:commercial.faqHeading,items:commercial.faq.map(item=>({...item,answer:bind(item.answer)}))}}:section):data.sections,
    } : data;
    return { params: { slug: route.family === 'home' ? undefined : data.slug }, props: { page, route, commercial, pages: pages.map(entry => entry.data) } };
  });
}
interface Props { page: CollectionEntry<'pages'>['data']; commercial: HomepageContent; pages: CollectionEntry<'pages'>['data'][]; route: ReturnType<typeof resolveRouteFamily>; }
const { page, commercial, pages, route } = Astro.props;
---
<SiteLayout title={page.seo.title} description={page.seo.description}>
  {route.family === 'home' ? <HomePage page={page} /> : route.family === 'pricing' ? <PricingPage page={page} commercial={commercial} /> : route.family === 'service' ? <ServicePage page={page} commercial={commercial} route={route} /> : route.family === 'index' ? <InsightIndexPage page={page} pages={pages} /> : <InnerPage page={page} />}
</SiteLayout>
