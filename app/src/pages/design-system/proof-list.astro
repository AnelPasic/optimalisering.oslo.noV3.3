---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProofList from '../../components/ProofList.astro';
import type { ProofListConfig } from '../../lib/proof-list';
const specimens:{id:string;title:string;description:string;config:ProofListConfig}[]=[
  {id:'proof-list-standard',title:'Global standard',description:'Uten utvalg: viser alle godkjente kundecaser og standard layout.',config:{layout:'inherit',entries:[]}},
  {id:'proof-list-kort',title:'Bildekort · Nysta + Eurotents',description:'To manuelt valgte kundecaser i redaktørens rekkefølge.',config:{layout:'mediaCards',entries:[{caseId:'nysta'},{caseId:'eurotents'}]}},
  {id:'proof-list-vekslende',title:'Vekslende · Helt Opplagt + Nysta',description:'Samme globalt godkjente bevis, en annen plassering og visning.',config:{layout:'alternating',entries:[{caseId:'helt-opplagt'},{caseId:'nysta'}]}},
  {id:'proof-list-en',title:'Én kundecase · Nysta',description:'Enkeltcase, med global tekst og dokumentasjon.',config:{layout:'mediaCards',entries:[{caseId:'nysta'}]}},
];
---
<SiteLayout title="ProofList – intern komponentkontroll" description="Visuell kontroll av ProofList i begge daisyUI-temaer." noindex>
  <header class="section-space bg-base-100 text-base-content">
    <div class="shell">
      <p class="eyebrow">Designsystem · intern QA</p>
      <h1>ProofList</h1>
      <p>Her sammenlignes én, to og flere caser med ulike visninger. Data og godkjenning hentes fra den samme globale masteren. Ingen redigerte kundetall eller nye bevis.</p>
    </div>
  </header>
  {specimens.map(item=><div data-proof-list-specimen={item.id}>
    <div class="shell pt-12 pb-4"><h2>{item.title}</h2><p>{item.description}</p></div>
    <ProofList sectionId={item.id} config={item.config} />
  </div>)}
</SiteLayout>
