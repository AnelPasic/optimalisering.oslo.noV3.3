---
import SiteLayout from '../layouts/SiteLayout.astro';
import CommercialHero from '../components/CommercialHero.astro';
import {resolveGlossaryHero} from '../lib/page-hero';
import { categories, glossary } from '../lib/terminology';
---
<SiteLayout title={`${glossary.title} | Optimalisering Oslo`} description={glossary.description}>
  <div class="shell">
    <CommercialHero content={resolveGlossaryHero(glossary)}>
      <nav slot="copy-end" class="glossary-navigation" aria-label={glossary.linkLabel}>
        {categories.map((category, index) => <a href={`#kategori-${index + 1}`}>{category}</a>)}
      </nav>
    </CommercialHero>

    {categories.map((category, index) => <section class="glossary-group" aria-labelledby={`kategori-${index + 1}`}>
      <div class="glossary-group-heading">
        <p class="eyebrow">{String(index + 1).padStart(2, '0')}</p>
        <h2 id={`kategori-${index + 1}`}>{category}</h2>
      </div>
      <div class="glossary-list">
        {glossary.terms.filter(term => term.category === category).map(term =>
          <article id={term.id} class="glossary-entry" aria-labelledby={`${term.id}-navn`}>
            <details>
              <summary>
                <span class="glossary-term-heading">
                  <span class="glossary-term-name" id={`${term.id}-navn`}>{term.term}</span>
                  {term.fullName && <span class="glossary-full-name">{term.fullName}</span>}
                </span>
                <span class="glossary-short">{term.shortDefinition}</span>
                <span class="glossary-toggle" aria-hidden="true">+</span>
              </summary>
              <div>
                <p>{term.fullDefinition}</p>
                {term.simpleExample && <p class="glossary-example"><strong>{glossary.exampleLabel}: </strong>{term.simpleExample}</p>}
                <a class="glossary-anchor" href={`#${term.id}`} aria-label={`Direktelenke til ${term.term}`}>#{term.id}</a>
              </div>
            </details>
          </article>
        )}
      </div>
    </section>)}
  </div>

  <script is:inline>
    (() => {
      const openHash = () => {
        let id;
        try { id = decodeURIComponent(location.hash.slice(1)); }
        catch { return; }
        if (!id) return;
        const target = document.getElementById(id);
        const details = target?.querySelector('details');
        if (details) details.open = true;
      };
      openHash();
      addEventListener('hashchange', openHash);
    })();
  </script>
</SiteLayout>
