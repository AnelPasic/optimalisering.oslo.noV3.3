---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { categories, glossary } from '../lib/terminology';
const home = (await getCollection('pages')).find(entry => entry.data.slug === 'home')!.data.homepage!;
---
<SiteLayout title={`${glossary.title} | Optimalisering Oslo`} description={glossary.description} homeVisual homeChrome={home.chrome}>
  <div class="shell">
    <header class="glossary-hero"><h1>{glossary.title}</h1><p>{glossary.intro}</p>
      <nav class="glossary-navigation" aria-label={glossary.linkLabel}>{categories.map((category, index) => <a href={`#kategori-${index + 1}`}>{category}</a>)}</nav>
    </header>
    {categories.map((category, index) => <section class="glossary-group" aria-labelledby={`kategori-${index + 1}`}>
      <h2 id={`kategori-${index + 1}`}>{category}</h2>
      {glossary.terms.filter(term => term.category === category).map(term => <article id={term.id} class="glossary-entry" aria-labelledby={`${term.id}-navn`}>
        <h3 id={`${term.id}-navn`}><a href={`#${term.id}`}>{term.term}</a></h3>
        {term.fullName && <p class="glossary-full-name">{term.fullName}</p>}
        <p>{term.fullDefinition}</p>
        {term.simpleExample && <p class="glossary-example"><strong>{glossary.exampleLabel}: </strong>{term.simpleExample}</p>}
      </article>)}
    </section>)}
  </div>
</SiteLayout>
