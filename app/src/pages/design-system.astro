---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PackageSection from '../components/PackageSection.astro';
import PageList from '../components/PageList.astro';
import { getGlobalElement, getHomepageBlock, isHomepageSectionVisible } from '../lib/home-builder';
import CommercialHero from '../components/CommercialHero.astro';
import {resolvePageHero} from '../lib/page-hero';
import {resolveHomepageContent} from '../lib/home-builder';
import HomeSection from '../components/HomeSection.astro';
import ContentCard from '../components/ContentCard.astro';
import HomeAssessment from '../components/HomeAssessment.astro';
import Faq from '../components/Faq.astro';
import {createCommercialTextBinding} from '../lib/commercial-text';
import {contentLayoutValues,boxVariantValues} from '../lib/content-presentation';
import {heroLayoutValues,heroPresetLabels} from '../lib/hero-presentation';
const pages=(await getCollection('pages')).map(p=>p.data);
const home=pages.find(p=>p.kind==='home')!;
const pageList=pages.find(p=>p.kind==='index')!.sections.find(s=>s.pageList)!;
const examples=[getGlobalElement('mekanisme'),getGlobalElement('passer')];
const ordinary=getGlobalElement('mekanisme');
const assessment=getHomepageBlock(home,'assessment').content;
const faqSource=getHomepageBlock(home,'faq').content;
const bindCommercialText=createCommercialTextBinding(home,pages.find(p=>p.kind==='pricing')!);
const faq={...faqSource,items:faqSource.items.map(item=>({...item,answer:bindCommercialText(item.answer)}))};
const layoutLabels={'default':'Standard (automatisk)','two-columns':'To kolonner','three-columns':'Tre kolonner','stacked':'Liste (én kolonne)'};
const boxLabels={'default':'Standard (automatisk)','plain':'Åpen boks','card':'Kort'};
const homeHero=resolvePageHero(home);
const heroExamples=[
 ...heroLayoutValues.map(layout=>({key:layout,label:heroPresetLabels[layout],purpose:'CMS-valg',preset:layout,hero:resolvePageHero({...home,hero:{...home.hero!,layout}})})),
 {key:'short',label:'Kort overskrift',purpose:'Stresstest, ikke eget CMS-valg',preset:undefined,hero:{...homeHero,title:'Bli funnet.',titleEmphasis:'none' as const}},
 {key:'service',label:'Tjeneste – samme CMS-valg og bevart bilde',purpose:'Sidekilde / kontekst, ikke eget CMS-valg',preset:undefined,hero:resolvePageHero(pages.find(p=>p.slug==='synlighet')!)},
 {key:'pricing',label:'Priser – teksten hentes fra Pakker, oppsett velges på Priser',purpose:'Sidekilde / kontekst, ikke eget CMS-valg',preset:undefined,hero:resolvePageHero(pages.find(p=>p.kind==='pricing')!,resolveHomepageContent(home))},
 {key:'long',label:'Lang overskrift',purpose:'Stresstest, ikke eget CMS-valg',preset:undefined,hero:{...homeHero,layout:'centered' as const,title:'Gjør veien fra det første relevante søket til en tydelig henvendelse enklere for kundene som vurderer bedriften din.',titleEmphasis:'none' as const}},
];
const colors=['base-100','base-200','base-300','base-content','primary','primary-content','secondary','secondary-content','accent','accent-content','neutral','neutral-content','info','info-content','success','success-content','warning','warning-content','error','error-content'];
const daisyCardSamples = [
  {name:'base-100',classes:'bg-base-100 text-base-content'},
  {name:'base-200',classes:'bg-base-200 text-base-content'},
  {name:'base-300',classes:'bg-base-300 text-base-content'},
  {name:'primary',classes:'bg-primary text-primary-content'},
  {name:'secondary',classes:'bg-secondary text-secondary-content'},
  {name:'accent',classes:'bg-accent text-accent-content'},
  {name:'neutral',classes:'bg-neutral text-neutral-content'},
  {name:'info',classes:'bg-info text-info-content'},
  {name:'success',classes:'bg-success text-success-content'},
  {name:'warning',classes:'bg-warning text-warning-content'},
  {name:'error',classes:'bg-error text-error-content'},
] as const;
const ds={
 section:'ds-section border-t border-base-300 pt-12 md:pt-16 space-y-8 md:space-y-10',
 group:'ds-group space-y-5 md:space-y-6',
 specimen:'ds-specimen rounded-box border border-base-300 bg-base-100 p-6 md:p-8',
 type:'ds-type-specimen grid gap-4 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-8 py-7 md:py-9 border-b border-base-300',
 grid:'ds-grid-demo space-y-6 md:space-y-8',
};
---
<SiteLayout title="Designsystem – intern gjennomgang" description="Intern gjennomgang av tema, typografi og komponenter." noindex>
 <div data-theme-root class="design-system bg-base-200 text-base-content">
  <header class="mx-auto max-w-7xl px-5 pt-12 pb-16 md:pt-16 md:pb-20 space-y-8">
   <div class={ds.group}><p class="badge badge-warning">Internt / kun for gjennomgang · DRAFT</p><h1>Felles designsystem</h1><p class="type-lead">Tema, typografi og komponenter for Optimalisering.</p></div>
   <fieldset class={ds.specimen}><legend class="font-semibold px-2">Temasammenligning</legend><div class="flex flex-col md:flex-row flex-wrap gap-5 md:gap-8">
    <label class="flex items-center gap-3"><input type="radio" name="theme" class="radio theme-controller" value="optimalisering" checked /> Optimalisering (godkjent standardtema)</label>
    <label class="flex items-center gap-3"><input type="radio" name="theme" class="radio theme-controller" value="light" /> Light (kun QA, ikke godkjent merkevaretema)</label>
   </div></fieldset>
   <p>Eksemplene er til intern visuell vurdering. Skjemaet sender ingen opplysninger.</p>
  </header>
  <div class="mx-auto max-w-7xl px-5 pb-20 md:pb-28 space-y-16 md:space-y-24">
   <section class={ds.section}><div class={ds.group}><h2>Semantiske farger og geometri</h2><p>Farger, radiuser og felthøyder fra det felles temaet.</p></div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">{colors.map(color=><div class="card bg-base-100 border border-base-300 overflow-hidden"><div class="h-16" style={`background:var(--color-${color})`}></div><p class="p-4 break-words">{color}</p></div>)}</div>
    <div class={ds.group}><h3>Geometri</h3><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div class="border border-base-300 rounded-selector p-5">Valg: 6 px</div><div class="border border-base-300 rounded-field p-5">Felt: 8 px / 48 px høyde</div><div class="border border-base-300 rounded-box p-5">Kort: 20 px</div><div class="border border-base-300 rounded-feature p-5">Fremhevet: 24 px</div></div></div>
   </section>
   <section class={ds.section}><div class={ds.group}><h2>Typografi</h2><p>Hver rad viser én rolle i den godkjente skalaen.</p></div>
    <div class={ds.specimen}>
     <article class={ds.type}><p class="eyebrow">Display</p><p class="type-display">Mer ut av trafikken.</p></article>
     <article class={ds.type}><p class="eyebrow">H1</p><p class="type-h1">Et tydelig utgangspunkt</p></article>
     <article class={ds.type}><p class="eyebrow">H2</p><h2>Bedre sammenheng</h2></article>
     <article class={ds.type}><p class="eyebrow">H3</p><h3>Små forbedringer som virker sammen</h3></article>
     <article class={ds.type}><p class="eyebrow">H4</p><h4>Neste steg</h4></article>
     <article class={ds.type}><p class="eyebrow">Lead</p><p class="type-lead">Vi ser på hele veien fra søk til henvendelse.</p></article>
     <article class={ds.type}><p class="eyebrow">Body</p><p>En god nettside gjør det lett å forstå tilbudet og velge neste steg. Når innhold og struktur virker sammen, blir det enklere å finne frem. Dette er et internt eksempel med flere setninger og naturlig linjebryting.</p></article>
     <article class={ds.type}><p class="eyebrow">Meta / Eyebrow</p><div class="space-y-5"><p class="eyebrow">Liten overskrift / eyebrow</p><p class="small-copy">Metadata · Oppdatert 15. oktober 2026</p></div></article>
    </div>
    <div class={ds.group}><h3>Lang overskrift</h3><div class={ds.specimen}><h2>En svært lang norsk overskrift om hvordan synlighet og konvertering kan gjøre det enklere å finne et tydelig sted å starte</h2></div></div>
   </section>
   <section class={ds.section}><div class={ds.group}><h2>Hero-varianter</h2><p>De fire første eksemplene er valgene i Hero → Oppsett i Pages CMS, med samme navn og samme Hero. Sentrert uten bilde skjuler bildet uten å slette det, beskrivelsen eller utsnittet. Sentrert med bilde viser bare tekst når siden ikke har et lagret bilde. Kort/lang overskrift er stresstester; Tjeneste/Priser viser ulike sidekilder og er ikke ekstra oppsett.</p></div>
    <div class="space-y-16 md:space-y-24">{heroExamples.map(example=><div class={ds.group} data-hero-demo={example.key} data-cms-hero-preset={example.preset}><p class="eyebrow">{example.purpose}</p><h3>{example.label}</h3><div class="rounded-box border border-base-300 bg-base-100"><CommercialHero content={example.hero} demo /></div></div>)}</div>
   </section>
   <section class={ds.section}><div class={ds.group}><h2>Knapper og status</h2><p>Varianter og tilstander vurderes i egne grupper.</p></div>
    <div class={ds.group}><h3>Knapper</h3><div class="flex flex-wrap items-center gap-4"><button class="btn btn-primary" data-theme-sample>Se hvor vi ville startet</button><button class="btn btn-secondary">Les om arbeidsmåten</button><button class="btn btn-ghost">Tilbake</button><a class="btn btn-link" href="#eksempelskjema">Gå til eksempelskjemaet</a><button class="btn btn-primary" disabled>Innsending er stengt</button></div></div>
    <div class={ds.group}><h3>Merker</h3><div class="flex flex-wrap gap-4"><span class="badge badge-primary">Synlighet</span><span class="badge badge-secondary">Konvertering</span><span class="badge badge-success">Eksempelstatus</span></div></div>
    <div class={ds.group}><h3>Meldinger</h3><div class="space-y-5"><p class="alert alert-info">Informasjon: Dette er en intern gjennomgang.</p><p class="alert alert-success">Bekreftelse: Eksempelet er klart for vurdering.</p><p class="alert alert-warning">Forhåndsvisning: Innsending er ikke åpnet.</p><p class="alert alert-error">Eksempelfeil: Fyll ut en gyldig nettadresse.</p></div></div>
   </section>
   <section class={ds.section}><div class={ds.group}><h2>Kort og varierende antall</h2><p>Hver rad viser et eget antall kort med samme indre avstand.</p></div>
    <div class="space-y-12 md:space-y-16">{[2,3,4].map(count=><div class={ds.grid}><h3>{count} kort</h3><div class:list={['grid gap-6',count===2?'md:grid-cols-2':count===3?'md:grid-cols-3':'md:grid-cols-2 xl:grid-cols-4']}>{Array.from({length:count},(_,index)=><ContentCard title={index===0?'Et tydelig utgangspunkt':'Et neste steg med en bevisst lang norsk overskrift'} text="Vurder innhold, struktur og veien videre i sammenheng." surface={index===1?'base-200':index===2?'secondary':'base-100'}><button slot="actions" class="btn btn-primary">Se eksempelet</button></ContentCard>)}</div></div>)}</div>
    <div class={ds.group} id="daisyui-kort">
     <h3>daisyUI Card – semantiske farger</h3>
     <p>Samme rene daisyUI-kort i alle 11 temafarger. Her kan du sammenligne bakgrunn, tekstkontrast og en standardknapp uten prosjektets egne fargealiaser. Knappene er kun visuelle eksempler.</p>
     <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-daisy-card-gallery>
      {daisyCardSamples.map(sample=><article class:list={['card min-w-0 min-h-64 border border-current/10',sample.classes]} data-daisy-card-color={sample.name}>
       <div class="card-body gap-4">
        <p class="text-sm font-semibold opacity-80">{sample.name}</p>
        <h4 class="card-title">Et tydelig kort</h4>
        <p class="card-copy">Vurder hvordan bakgrunn, overskrift og brødtekst fungerer sammen i et ekte daisyUI-kort.</p>
        <div class="card-actions mt-auto justify-end"><span class="btn btn-sm">Knapp (demo)</span></div>
       </div>
      </article>)}
     </div>
    </div>
    <div class={ds.group}><h3>Kort med bilde</h3><article class="card md:card-side bg-base-100"><figure class="md:w-1/2"><img src="/images/home/hero-customer.webp" alt="Eksisterende illustrasjonsfoto fra forsiden" loading="lazy" /></figure><div class="card-body gap-5"><p class="card-copy">Medieeksempel med eksisterende bilde. Ingen ny kundehistorie.</p></div></article></div>
    <div class={ds.group}><h3>Resultatprimitiv</h3><div class="stats stats-vertical md:stats-horizontal bg-base-100 w-full"><div class="stat"><div class="stat-title">Resultatprimitiv</div><div class="stat-value">–</div><div class="stat-desc">Ingen nye resultatpåstander. Faktiske bevisdata er uendret.</div></div><div class="stat"><div class="stat-title">Datagrunnlag</div><div class="stat-value">–</div><div class="stat-desc">Kun demonstrasjon av komponenten.</div></div></div></div>
   </section>
   <section class={ds.section}><div class={ds.group}><h2>Spørsmål og skjema</h2><p>Skjemaet er et internt eksempel med deaktivert innsending.</p></div>
    <div class={ds.group}><h3>Generisk daisyUI collapse</h3><p>Én frittstående accordion. Forsidens faktiske FAQ-seksjon vises separat nedenfor.</p><details class="collapse collapse-plus bg-base-100"><summary class="collapse-title">Kan jeg bruke skjemaet i denne gjennomgangen?</summary><div class="collapse-content"><p>Dette er et internt eksempel. Innsending er deaktivert.</p></div></details></div>
    <p>Skjemaet nedenfor viser generiske felt og tilstander. Det er en annen komponent enn forsideskjemaet.</p>
    <form id="eksempelskjema" class="ds-form card bg-base-100" onsubmit="return false"><div class="card-body gap-7 md:gap-8"><h3>Et uforpliktende eksempel</h3>
     <label>Nettside eller nettbutikk<input class="input w-full" type="url" placeholder="https://eksempel.no" /></label>
     <label>Hva vil du se nærmere på?<select class="select w-full"><option>Velg et område</option><option>Synlighet og konvertering</option></select></label>
     <label>En bevisst lang norsk feltetikett som skal kunne brytes over flere linjer på en smal skjerm<textarea class="textarea w-full" rows="3" placeholder="Beskriv kort hva du vil vurdere"></textarea></label>
     <label>Illustrativt nivå<input class="range range-primary w-full" type="range" min="0" max="100" value="40" /></label>
     <button class="btn btn-primary self-start" type="submit" disabled>Innsending er ikke åpnet</button>
    </div></form>
   </section>
   <section class={ds.section}><div class={ds.group}><h2>Seksjonsflater og justering</h2><p>Lik ytre avstand og indre polstring i alle flateeksempler.</p></div><div class="grid gap-6 md:gap-8">{['base-100','base-200','info','lavender','secondary'].map((surface,index)=><section class:list={['ds-surface rounded-box p-6 md:p-10 space-y-5',index%2===0?'text-center':'text-left']} style={`background:var(--color-${surface});color:var(--color-${surface==='secondary'?'secondary-content':surface==='info'?'info-content':'base-content'})`}><p class="eyebrow">{surface}</p><h3>{index%2===0?'Sentrert overskrift':'Venstrejustert overskrift'}</h3><p>Felles farger og lesbar tekst i samme designsystem.</p></section>)}</div></section>
   {isHomepageSectionVisible(ordinary)&&<>
   <section class={ds.section} id="cms-content-variants"><div class={ds.group}><h2>CMS: seksjonstype, oppsett og boksvariant</h2>
    <p>Seksjonstype bestemmer innholdsmodellen: Innholdsseksjon, Regneeksempel, Pakker og priser og de øvrige beskyttede seksjonene har ulike oppgaver. Seksjonstype er ikke et fargevalg eller en boksvariant.</p>
    <p>Forside → Innholdsseksjoner → åpne en Innholdsseksjon. Globale innholdsoriginaler redigeres under Globale elementer. Seksjonsfarge gjelder hele flaten; Boksfarge gjelder én boks. Seksjonsoppsett fordeler boksene. Boksvariant velger Åpen boks eller Kort. Standard og tomt valg beholder automatisk design. Ingen felt tar CSS-klasser eller frie mål.</p>
    <p>Hero ligger fast først. Pris, bevis, regneeksempel og skjema redigeres under Globale elementer og har egne innholdsmodeller. Forsiden velger plasseringer i tre flyttbare grupper. Skjul eller fjern en plassering for å beholde originalen i biblioteket. Åtte originaler er bevart; åtte synlige plasseringer er ikke påkrevd.</p>
   </div>
    <div class="space-y-12 md:space-y-16">{contentLayoutValues.map(layout=><div class={ds.group} data-content-layout-demo={layout}><h3>Seksjonsoppsett: {layoutLabels[layout]}</h3><p>CMS: Seksjonsoppsett. Samme innhold og samme bokser. Valgte kolonneoppsett blir én kolonne på mobil; Standard beholder seksjonens automatiske fordeling.</p><div class="ds-real-example invite-home"><HomeSection section={{...ordinary,layout}} anchor={`ds-layout-${layout}`} /></div></div>)}</div>
    <div class={ds.group}><h3>Boksvariant</h3><p>CMS: Alternativer eller steg → Boksvariant. Her holdes innhold, kolonneoppsett og boksfarge like. Åpen boks gir 24 px indre luft uten avrundet kortflate. Kort bruker det godkjente Card-designet med 24 px polstring og 20 px radius. Standard arver seksjonens automatiske design. Med valgt boksfarge kan Standard og Åpen boks se like ut; Standard er ikke et tredje fast kortdesign.</p><div class="ds-real-example invite-home"><HomeSection section={{...ordinary,id:'ds-box-variants',heading:'Samme innhold, tre boksvalg',body:[],layout:'three-columns',items:boxVariantValues.map(boxVariant=>({...ordinary.items![0],title:boxLabels[boxVariant],boxVariant}))}} /></div></div>
    <div class={ds.group}><h3>Standard følger seksjonen</h3><p>Samme kildeinnhold som Mekanisme, vist med Standard og uten valgt boksfarge. Da beholdes seksjonens opprinnelige nummererte, redaksjonelle oppsett. Dette er en sammenligningstilstand; forsidens lagrede kortvalg er uendret.</p><div class="ds-real-example invite-home"><HomeSection section={{...ordinary,items:ordinary.items!.map(item=>({...item,boxVariant:'default',surface:'default'}))}} anchor="ds-auto-editorial" /></div></div>
    <div class={ds.group}><h3>Farge velges separat</h3><p>Kort med tre av de eksisterende H-019-fargene. Oppsett og boksvariant er like.</p><div class="ds-real-example invite-home"><HomeSection section={{...ordinary,id:'ds-box-colors',heading:'Samme kort, ulike flater',body:[],layout:'three-columns',items:(['info','lavender','secondary'] as const).map(surface=>({...ordinary.items![0],title:surface,boxVariant:'card',surface}))}} /></div></div>
   </section>
   </>}
   {isHomepageSectionVisible(getHomepageBlock(home,'packages'))&&<section class={ds.section}><div class={ds.group}><h2>Eksisterende kommersielle komponenter</h2><p>Hentet fra samme kilde som forsiden. Priser, ordvalg og valglogikk er uendret.</p></div><div class="ds-real-example invite-home"><PackageSection content={getHomepageBlock(home,'packages').content} /></div></section>}
   <section class={ds.section}><div class={ds.group}><h2>PageList og CMS-styrte seksjoner</h2><p>Eksisterende primitiveksempler i egne presentasjonsgrupper.</p></div>
    <div class="ds-real-example space-y-12 md:space-y-16"><div class={ds.group}><h3>Vekslende liste</h3><PageList section={{...pageList,id:'ds-alternating',pageList:{...pageList.pageList!,layout:'alternating'}}} pages={pages} /></div><div class={ds.group}><h3>Bildekort</h3><PageList section={{...pageList,id:'ds-media',pageList:{...pageList.pageList!,layout:'mediaCards'}}} pages={pages} /></div>{examples.map(section=><div class={ds.group}><HomeSection section={section} /></div>)}</div>
   </section>
  </div>
  <section class="space-y-8" id="production-home-sections"><div class="shell space-y-5"><h2>Faktiske seksjoner fra forsiden</h2><p>Samme produksjonskomponenter og gjeldende CMS-innhold som på forsiden, vist i hele sidebredden. Eksempel-ID-er er egne; skjemaet har deaktivert innsending og ingen endepunktadresse.</p>{isHomepageSectionVisible(getHomepageBlock(home,'assessment'))&&<><h3>Kontakt: To kolonner (dagens)</h3><p>CMS: Gratis sjekk → Kontaktoppsett. Tomt valg eller To kolonner beholder denne godkjente standardvarianten.</p></>}</div>{isHomepageSectionVisible(getHomepageBlock(home,'assessment'))&&<><div class="invite-home"><HomeAssessment section={assessment.section} content={assessment.form} layout="split" specimen /></div><div class="shell space-y-5"><h3>Kontakt: Vannrett (kompakt skjema)</h3><p>Alternativt CMS-oppsett med samme kilde og komponent. Nettside, e-post og knapp står på én rad på desktop; støttetekster og valgfri kommentar bevares. Dette er et alternativ for OWNER-review, ikke en endring av forsidens standard.</p></div><div class="invite-home"><HomeAssessment section={assessment.section} content={assessment.form} layout="horizontal" specimen /></div></>}{isHomepageSectionVisible(getHomepageBlock(home,'faq'))&&<><div class="shell"><h3>Forsidens FAQ</h3></div><div class="invite-home"><Faq id="ds-home-faq" {...faq} /></div></>}</section>
 </div>
</SiteLayout>
<style>
 .design-system { overflow-wrap: anywhere; }
 .design-system section, .ds-type-specimen > * { min-width: 0; }
 .ds-form label { display: block; font-size: var(--type-form-label); line-height: var(--leading-small); }
 .ds-form label input, .ds-form label select, .ds-form label textarea { display: block; margin-top: 12px; }
 .ds-real-example :global(.section-space) { padding-block: 24px; }
 .type-display, .type-h1 { font-family: var(--heading); font-size: var(--type-display); font-weight: var(--weight-heading); line-height: var(--leading-display); }
 .type-lead { font-size: var(--type-lead); line-height: var(--leading-lead); }
</style>
