---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PackageSection from '../components/PackageSection.astro';
import PageList from '../components/PageList.astro';
import HomeSection from '../components/HomeSection.astro';
const pages = (await getCollection('pages')).map(p => p.data);
const home = pages.find(p => p.kind === 'home')!;
const colors = ['base-100','base-200','base-300','base-content','primary','primary-content','secondary','secondary-content','accent','accent-content','neutral','neutral-content','info','info-content','success','success-content','warning','warning-content','error','error-content'];
const pageList = pages.find(p => p.slug === 'innsikt')!.sections.find(s => s.pageList)!;
const examples = home.sections.filter(s => ['mekanisme','passer'].includes(s.id));
---
<SiteLayout title="Designsystem – intern gjennomgang" description="Intern gjennomgang av tema, typografi og komponenter." noindex homeVisual homeChrome={home.homepage!.chrome}>
  <div data-theme-root class="design-system bg-base-200 text-base-content">
    <header class="mx-auto max-w-7xl px-5 py-12 space-y-6">
      <p class="badge badge-warning">Internt / kun for gjennomgang · DRAFT</p>
      <h1>Felles designsystem</h1>
      <p class="type-lead">Tema, typografi og komponenter for Optimalisering.</p>
      <fieldset class="flex flex-wrap gap-5"><legend class="font-semibold mb-3">Temasammenligning</legend>
        <label class="flex items-center gap-3"><input type="radio" name="theme" class="radio theme-controller" value="optimalisering" checked /> Optimalisering (godkjent standardtema)</label>
        <label class="flex items-center gap-3"><input type="radio" name="theme" class="radio theme-controller" value="light" /> Light (kun QA, ikke godkjent merkevaretema)</label>
      </fieldset>
      <p>Eksemplene er til intern visuell vurdering. Skjemaet sender ingen opplysninger.</p>
    </header>
    <div class="mx-auto max-w-7xl px-5 pb-16 space-y-16">
      <section class="space-y-6"><h2>Semantiske farger og geometri</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">{colors.map(color => <div class="card bg-base-100 border border-base-300 overflow-hidden"><div class="h-16" style={`background:var(--color-${color})`}></div><p class="p-4 break-words">{color}</p></div>)}</div>
        <div class="flex flex-wrap gap-6"><div class="border border-base-content rounded-selector p-5">Valg: 6 px</div><div class="border border-base-content rounded-field p-5">Felt: 8 px / 48 px høyde</div><div class="border border-base-content rounded-box p-5">Kort: 20 px</div><div class="border border-base-content rounded-feature p-5">Fremhevet: 24 px</div></div>
      </section>
      <section class="space-y-5"><h2>Typografi</h2>
        <p class="type-display">Mer ut av trafikken.</p><p class="type-h1">H1 · Et tydelig utgangspunkt</p><h2>H2 · Bedre sammenheng</h2><h3>H3 · Små forbedringer som virker sammen</h3><h4>H4 · Neste steg</h4>
        <h2>En svært lang norsk overskrift om hvordan synlighet og konvertering kan gjøre det enklere å finne et tydelig sted å starte</h2>
        <p class="type-lead">Ingress: Vi ser på hele veien fra søk til henvendelse.</p>
        <p>Brødtekst: En god nettside gjør det lett å forstå tilbudet og velge neste steg. Når innhold og struktur virker sammen, blir det enklere å finne frem. Dette er et internt eksempel med flere setninger og naturlig linjebryting.</p>
        <p class="eyebrow">Liten overskrift / eyebrow</p><p class="small-copy">Metadata · Oppdatert 15. oktober 2026</p>
      </section>
      <section class="space-y-6"><h2>Knapper og status</h2>
        <div class="flex flex-wrap items-center gap-4"><button class="btn btn-primary" data-theme-sample>Se hvor vi ville startet</button><button class="btn btn-secondary">Les om arbeidsmåten</button><button class="btn btn-ghost">Tilbake</button><a class="btn btn-link" href="#eksempelskjema">Gå til eksempelskjemaet</a><button class="btn btn-primary" disabled>Innsending er stengt</button></div>
        <div class="flex flex-wrap gap-4"><span class="badge badge-primary">Synlighet</span><span class="badge badge-secondary">Konvertering</span><span class="badge badge-success">Eksempelstatus</span></div>
        <div class="space-y-4"><p class="alert alert-info">Informasjon: Dette er en intern gjennomgang.</p><p class="alert alert-success">Bekreftelse: Eksempelet er klart for vurdering.</p><p class="alert alert-warning">Forhåndsvisning: Innsending er ikke åpnet.</p><p class="alert alert-error">Eksempelfeil: Fyll ut en gyldig nettadresse.</p></div>
      </section>
      <section class="space-y-6"><h2>Kort og varierende antall</h2>
        {[2,3,4].map(count => <div class:list={['grid gap-6', count===2?'md:grid-cols-2':count===3?'md:grid-cols-3':'md:grid-cols-2 xl:grid-cols-4']}>{Array.from({length:count},(_,index)=><article class:list={['card',index===1?'bg-base-200 border border-base-300':index===2?'bg-secondary text-secondary-content':'bg-base-100']}><div class="card-body"><h3 class="card-title">{index===0?'Et tydelig utgangspunkt':'Et neste steg med en bevisst lang norsk overskrift'}</h3><p>Vurder innhold, struktur og veien videre i sammenheng.</p><div class="card-actions"><button class="btn btn-primary">Se eksempelet</button></div></div></article>)}</div>)}
        <article class="card md:card-side bg-base-100"><figure class="md:w-1/2"><img src="/images/home/hero-customer.webp" alt="Eksisterende illustrasjonsfoto fra forsiden" loading="lazy" /></figure><div class="card-body"><h3 class="card-title">Kort med bilde</h3><p>Medieeksempel med eksisterende bilde. Ingen ny kundehistorie.</p></div></article>
        <div class="stats stats-vertical md:stats-horizontal bg-base-100 w-full"><div class="stat"><div class="stat-title">Resultatprimitiv</div><div class="stat-value">–</div><div class="stat-desc">Ingen nye resultatpåstander. Faktiske bevisdata er uendret.</div></div><div class="stat"><div class="stat-title">Datagrunnlag</div><div class="stat-value">–</div><div class="stat-desc">Kun demonstrasjon av komponenten.</div></div></div>
      </section>
      <section class="space-y-6"><h2>Spørsmål og skjema</h2><details class="collapse collapse-plus bg-base-100"><summary class="collapse-title">Kan jeg bruke skjemaet i denne gjennomgangen?</summary><div class="collapse-content"><p>Dette er et internt eksempel. Innsending er deaktivert.</p></div></details>
        <form id="eksempelskjema" class="card bg-base-100" onsubmit="return false"><div class="card-body gap-5"><h3>Et uforpliktende eksempel</h3>
          <label class="space-y-2">Nettside eller nettbutikk<input class="input w-full" type="url" placeholder="https://eksempel.no" /></label>
          <label class="space-y-2">Hva vil du se nærmere på?<select class="select w-full"><option>Velg et område</option><option>Synlighet og konvertering</option></select></label>
          <label class="space-y-2">En bevisst lang norsk feltetikett som skal kunne brytes over flere linjer på en smal skjerm<textarea class="textarea w-full" rows="3" placeholder="Beskriv kort hva du vil vurdere"></textarea></label>
          <label class="space-y-2">Illustrativt nivå<input class="range range-primary w-full" type="range" min="0" max="100" value="40" /></label>
          <button class="btn btn-primary self-start" type="submit" disabled>Innsending er ikke åpnet</button>
        </div></form>
      </section>
      <section class="space-y-6"><h2>Seksjonsflater og justering</h2>{['base','soft','mint','lavender','dark'].map((surface,index)=><section class:list={['rounded-box p-6 md:p-10 space-y-4',index%2===0?'text-center':'text-left']} style={`background:var(--color-${surface==='base'?'base-100':surface==='soft'?'base-200':surface==='dark'?'secondary':surface});color:var(--color-${surface==='dark'?'secondary-content':'base-content'})`}><p class="eyebrow">{surface}</p><h3>{index%2===0?'Sentrert overskrift':'Venstrejustert overskrift'}</h3><p>Felles farger og lesbar tekst i samme designsystem.</p></section>)}</section>
      <section class="space-y-6"><h2>Eksisterende kommersielle komponenter</h2><p>Hentet fra samme kilde som forsiden. Priser, ordvalg og valglogikk er uendret.</p><div class="invite-home"><PackageSection content={home.homepage!.packages} /></div></section>
      <section class="space-y-6"><h2>PageList og CMS-styrte seksjoner</h2><p>Eksisterende primitiveksempler. Bred rutemigrering behandles i H-023B.</p><PageList section={{...pageList, id: 'ds-alternating', pageList: {...pageList.pageList!, layout: 'alternating'}}} pages={pages} /><PageList section={{...pageList, id: 'ds-media', pageList: {...pageList.pageList!, layout: 'mediaCards'}}} pages={pages} />{examples.map(section=><HomeSection section={section} />)}
      </section>
    </div>
  </div>
</SiteLayout>
<style>
  .design-system { overflow-wrap: anywhere; }
  .design-system section { min-width: 0; }
  .design-system label { display: block; font-size: var(--type-form-label); line-height: var(--leading-small); }
  .design-system label input:not([type=radio]), .design-system label select, .design-system label textarea { display: block; margin-top: 8px; }
  .type-display, .type-h1 { font-family: var(--heading); font-size: var(--type-display); font-weight: var(--weight-heading); line-height: var(--leading-display); }
  .type-lead { font-size: var(--type-lead); line-height: var(--leading-lead); }
</style>
