{
  "name": "optimalisering-oslo-v3-3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs --api-only",
    "check": "astro check",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:intake": "node --test ../intake-worker/tests/*.test.mjs",
    "qa:intake:review": "node scripts/qa-intake-d129.mjs",
    "build": "astro build --force && npm run search:index",
    "preview": "node --env-file-if-exists=.env server/index.mjs",
    "qa:static": "npm run qa:copy && node scripts/audit-build.mjs && node scripts/audit-h007.mjs && node scripts/audit-h008.mjs && node scripts/audit-h009.mjs && node scripts/audit-h010.mjs && node scripts/audit-h011.mjs && node scripts/audit-h013.mjs && node scripts/audit-h016.mjs && node scripts/audit-h017c.mjs && node scripts/audit-h017e.mjs",
    "verify": "npm run check && npm test && npm run build && npm run qa:static && npm run qa:cms && npm run qa:surfaces && npm run qa:typography",
    "qa:surfaces": "node scripts/audit-surfaces.mjs",
    "qa:typography": "node scripts/audit-typography.mjs && node scripts/qa-typography.mjs",
    "deploy:review": "npm run verify && wrangler deploy",
    "leads:retry": "node --env-file-if-exists=.env server/retry.mjs",
    "qa:copy": "node scripts/audit-copy-style.mjs",
    "qa:cms": "node scripts/audit-cms-roundtrip.ts",
    "qa:proof": "node scripts/qa-proof-guard.mjs",
    "search:index": "npx --yes pagefind@1.5.2 --site dist && node scripts/verify-pagefind.mjs",
    "check:managed": "node scripts/check-managed-pages.mjs",
    "prebuild": "node scripts/prepare-clean-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.3.7",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.1",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  }
}
