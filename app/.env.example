# Draft preview is the default. Production mode requires readiness checks.
SITE_STAGE=preview
# Leave false until the Resend sender, local storage and privacy are configured.
PUBLIC_LEADS_ENABLED=false
# Independent order frontend/backend gates. Review keeps both false.
PUBLIC_ORDERS_ENABLED=false
ORDERS_ENABLED=false
# OWNER/OPS attestation after documented deployed-backend synthetic verification.
ORDERS_DEPLOYMENT_APPROVED=false
PUBLIC_LEAD_ENDPOINT=/api/leads
PORT=4321
API_PORT=4322
LEAD_SITE=optimalisering.oslo.no
ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
# Keep this database on persistent server storage and outside Git/public assets.
LEAD_DATA_DIR=./var
# Server-only; never use PUBLIC_ for secrets or recipients.
RESEND_API_KEY=
RESEND_FROM=
LEAD_TO_EMAIL=
PRIVACY_APPROVED=false
SOURCE_CAPTURE_ENABLED=true
